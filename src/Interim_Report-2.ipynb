        "    engine=\"python\"\n",
        ")\n",
        "\n",
        "qrels_val_2024 = pd.read_csv(\n",
        "    val_qrel_path,\n",
        "    sep=r\"\\s+\",\n",
        "    names=[\"query_id\", \"iteration\", \"doc_id\", \"relevance\"],\n",
        "    engine=\"python\"\n",
        ")\n",
        "\n",
        "qrels_test_2024 = pd.read_csv(\n",
        "    test_qrel_path,\n",
        "    sep=r\"\\s+\",\n",
