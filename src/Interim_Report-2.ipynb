        "torch.cuda.empty_cache()\n",
        "gc.collect()\n",
        "\n",
        "candidate_docnos = set(bm25_val_candidates[\"doc_id\"].unique())\n",
        "doc_text_map = {}\n",
        "\n",
        "for doc in corpus_2024.docs_iter():\n",
        "    doc_id = str(doc.doc_id)\n",
        "    if doc_id in candidate_docnos:\n",
