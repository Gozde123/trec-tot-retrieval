    {
      "cell_type": "code",
      "execution_count": 26,
      "metadata": {
        "id": "sshYFwt0vVdm"
      },
      "outputs": [],
      "source": [
        "# As a candidate size, 10000 was selected based on the candidate-size ablation results.\n",
        "# This value is used to provide enough documents for later SBERT and BGE-M3 reranking.\n",
        "best_candidate_size = 10000\n",
        "\n",
        "def bm25_sweep_run():\n",
        "    with wandb.init() as run:\n",
        "        config = wandb.config\n",
        "\n",
        "        k1 = config.k1\n",
        "        b = config.b\n",
        "        candidate_size = 10000\n",
        "\n",
        "        bm25 = pt.BatchRetrieve(\n",
        "            index,\n",
        "            wmodel=\"BM25\",\n",
        "            num_results=candidate_size,\n",
        "            controls={\"bm25.k_1\": k1, \"bm25.b\": b}\n",
        "        )\n",
        "\n",
        "        bm25_val_run = bm25.transform(val_queries_pt)\n",
        "\n",
        "        bm25_val_run_eval = bm25_val_run.rename(columns={\n",
        "            \"qid\": \"query_id\",\n",
        "            \"docno\": \"doc_id\"\n",
        "        })[[\"query_id\", \"doc_id\", \"score\", \"rank\"]].copy()\n",
        "\n",
        "        bm25_val_run_eval[\"query_id\"] = bm25_val_run_eval[\"query_id\"].astype(str)\n",
        "        bm25_val_run_eval[\"doc_id\"] = bm25_val_run_eval[\"doc_id\"].astype(str)\n",
        "        bm25_val_run_eval[\"rank\"] = bm25_val_run_eval[\"rank\"].astype(int) + 1\n",
        "\n",
        "        candidate_recall = ir_measures.calc_aggregate(\n",
        "            [Recall@candidate_size],\n",
        "            val_qrels_eval,\n",
        "            bm25_val_run_eval\n",
        "        )[Recall@candidate_size]\n",
        "\n",
        "        ranking_results = ir_measures.calc_aggregate(\n",
        "            [Recall@10, RR@10, nDCG@10,nDCG@100,nDCG@1000],\n",
        "            val_qrels_eval,\n",
        "            bm25_val_run_eval\n",
        "        )\n",
        "\n",
        "        wandb.log({\n",
        "            \"k1\": k1,\n",
        "            \"b\": b,\n",
        "            \"candidate_size\": candidate_size,\n",
        "            \"val_candidate_recall\": candidate_recall,\n",
        "            \"val_recall@10\": ranking_results[Recall@10],\n",
        "            \"val_rr@10\": ranking_results[RR@10],\n",
        "            \"val_ndcg@10\": ranking_results[nDCG@10],\n",
        "            \"val_ndcg@100\": ranking_results[nDCG@100],\n",
        "            \"val_ndcg@1000\": ranking_results[nDCG@1000]\n",
        "        })\n"
      ]
    },
