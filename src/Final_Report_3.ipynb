    "def top1_docs(run_df, model_name):\n",
    "    top1 = (\n",
    "        run_df.sort_values([\"query_id\", \"rank\"])\n",
    "        .groupby(\"query_id\")\n",
    "        .head(1)\n",
    "        [[\"query_id\", \"doc_id\"]]\n",
    "        .copy()\n",
    "    )\n",
    "    top1 = top1.rename(columns={\"doc_id\": f\"{model_name}_top1\"})\n",
    "    return top1\n",
    "\n",
    "agreement_df = top1_docs(bm25_val_run_eval, \"BM25\")\n",
    "\n",
    "agreement_df = agreement_df.merge(\n",
    "    top1_docs(sbert_hybrid_best_run, \"Hybrid_SBERT\"),\n",
    "    on=\"query_id\",\n",
    "    how=\"outer\"\n",
    ")\n",
    "\n",
    "agreement_df = agreement_df.merge(\n",
    "    top1_docs(bge_hybrid_best_run, \"Hybrid_BGE\"),\n",
    "    on=\"query_id\",\n",
    "    how=\"outer\"\n",
    ")\n",
    "\n",
    "agreement_df[\"BM25_vs_SBERT_same_top1\"] = (\n",
    "    agreement_df[\"BM25_top1\"] == agreement_df[\"Hybrid_SBERT_top1\"]\n",
    ")\n",
    "\n",
    "agreement_df[\"SBERT_vs_BGE_same_top1\"] = (\n",
    "    agreement_df[\"Hybrid_SBERT_top1\"] == agreement_df[\"Hybrid_BGE_top1\"]\n",
    ")\n",
    "\n",
    "summary_agreement = {\n",
    "    \"BM25 vs Hybrid SBERT Top-1 Agreement\": agreement_df[\"BM25_vs_SBERT_same_top1\"].mean(),\n",
    "    \"Hybrid SBERT vs Hybrid BGE-M3 Top-1 Agreement\": agreement_df[\"SBERT_vs_BGE_same_top1\"].mean()\n",
    "}\n",
    "\n",
    "display(pd.DataFrame([summary_agreement]))\n",
    "display(agreement_df.head(10))\n",
    "\n",
    "# For the case of the Top-1 Agreement, one can observe that there is an agreement between BM25 and Hybrid SBERT concerning the selection of\n",
    "# the most relevant document in only 21.3% of the queries.\n",
    "# In addition, for the comparison between Hybrid SBERT and Hybrid BGE-M3, there was a low agreement of 32.7%, although they have nearly equal performance."
   ]
