            "Base lambda=1.0 nDCG@10: 0.09853032964454414\n",
            "Best hybrid lambda: 0.7000000000000001\n",
            "Best hybrid nDCG@10: 0.15304349043434365\n"
          ]
        }
      ],
      "source": [
        "# Normalization func.\n",
        "bm25_norm = bm25_val_candidates.groupby(\"query_id\").apply(minmax_normalize).reset_index(drop=True)\n",
        "sbert_norm = sbert_val_run_eval.groupby(\"query_id\").apply(minmax_normalize).reset_index(drop=True)\n",
        "\n",
        "lambda_values = np.linspace(0, 1, 11)\n",
        "metrics = [nDCG@10, RR@10, Recall@10, Recall@100, Recall@500,nDCG@100,nDCG@1000]\n",
        "\n",
        "\n",
        "sbert_hybrid_runs = []\n",
        "sbert_hybrid_run_dict = {}\n",
        "\n",
        "for l in lambda_values:\n",
        "    run = wandb.init(project=\"trec-tot-hybrid-final\", name=f\"SBERT_Lambda_{l:.1f}_20k\", reinit=True)\n",
        "\n",
        "    merged = pd.merge(\n",
        "        bm25_norm,\n",
        "        sbert_norm,\n",
        "        on=[\"query_id\", \"doc_id\"],\n",
        "        suffixes=(\"_bm25\", \"_sbert\"),\n",
        "        how=\"outer\"\n",
        "    ).fillna(0)\n",
        "\n",
        "    merged[\"hybrid_score\"] = (1-l) * merged[\"norm_score_bm25\"] + l * merged[\"norm_score_sbert\"]\n",
        "    merged_for_eval = merged[[\"query_id\", \"doc_id\", \"hybrid_score\"]].rename(columns={\"hybrid_score\": \"score\"})\n",
        "\n",
        "    res = ir_measures.calc_aggregate(metrics, val_qrels_eval, merged_for_eval)\n",
        "\n",
        "    log_data = {\n",
        "        \"model\": \"SBERT\",\n",
        "        \"candidate_size\": 10000,\n",
        "        \"lambda\": l,\n",
        "        \"nDCG@10\": res[nDCG@10],\n",
        "        \"sbert_hybrid_nDCG@10\": res[nDCG@10],\n",
        "        \"sbert_hybrid_nDCG@100\": res[nDCG@100],\n",
        "        \"sbert_hybrid_nDCG@1000\": res[nDCG@1000],\n",
        "        \"sbert_hybrid_RR@10\": res[RR@10],\n",
        "        \"sbert_hybrid_Recall@10\": res[Recall@10]\n",
        "    }\n",
        "    wandb.log(log_data)\n",
        "    run.finish()\n",
        "\n",
        "    sbert_hybrid_runs.append(log_data)\n",
        "    sbert_hybrid_run_dict[float(l)] = merged_for_eval.copy()\n",
        "\n",
        "\n",
        "sbert_wb_df = pd.DataFrame(sbert_hybrid_runs)\n",
        "\n",
        "display(sbert_wb_df.sort_values(\"nDCG@10\", ascending=False))\n",
        "\n",
        "best_idx = sbert_wb_df[\"nDCG@10\"].idxmax()\n",
        "sbert_best_l = float(sbert_wb_df.loc[best_idx, \"lambda\"])\n",
        "sbert_best = float(sbert_wb_df.loc[best_idx, \"nDCG@10\"])\n",
        "\n",
        "\n",
        "base_row = sbert_wb_df[sbert_wb_df[\"lambda\"] == 1.0]\n",
        "if not base_row.empty:\n",
        "    sbert_base = float(base_row.iloc[0][\"nDCG@10\"])\n",
        "else:\n",
        "    sbert_base = \"NOT FIND\"\n",
        "\n",
        "\n",
        "sbert_hybrid_best_run = sbert_hybrid_run_dict[sbert_best_l].copy()\n",
        "\n",
        "\n",
        "print(\"SBERT:\")\n",
        "print(f\"Base lambda=1.0 nDCG@10: {sbert_base}\")\n",
        "print(f\"Best hybrid lambda: {sbert_best_l}\")\n",
        "print(f\"Best hybrid nDCG@10: {sbert_best}\")\n",
        "\n",
        "\n",
        "\n"
      ]
    },
