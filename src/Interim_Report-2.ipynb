      "source": [
        "monot5_hybrid_runs = []\n",
        "monot5_hybrid_run_dict = {}\n",
        "\n",
        "bm25_norm = (\n",
        "    bm25_val_candidates\n",
        "    .groupby(\"query_id\", group_keys=False)\n",
        "    .apply(normalize_per_query)\n",
        ")\n",
        "\n",
        "monot5_norm = (\n",
        "    monoT5_val_run_eval\n",
        "    .groupby(\"query_id\", group_keys=False)\n",
        "    .apply(normalize_per_query)\n",
        ")\n",
        "\n",
        "\n",
        "monot5_norm[\"query_id\"] = monot5_norm[\"query_id\"].astype(str)\n",
        "bm25_norm[\"query_id\"] = bm25_norm[\"query_id\"].astype(str)\n",
        "\n",
        "\n",
        "monot5_norm[\"query_id\"] = monot5_norm[\"query_id\"].astype(str)\n",
        "bm25_norm[\"query_id\"] = bm25_norm[\"query_id\"].astype(str)\n",
        "\n",
        "print(\"MonoT5 Lambda Sweep başlatılıyor...\")\n",
        "\n",
        "for l in np.linspace(0, 1, 11):\n",
        "\n",
        "    unique_id = f\"monot5_sweep_{l:.1f}_{int(time.time())}\"\n",
        "\n",
        "    run = wandb.init(\n",
        "        project=\"trec-tot-hybrid-final\",\n",
        "        name=f\"MonoT5_Lambda_{l:.1f}_20k\",\n",
        "        id=unique_id,\n",
        "        reinit=True\n",
        "    )\n",
        "\n",
        "    merged = pd.merge(\n",
        "        bm25_norm,\n",
        "        monot5_norm,\n",
        "        on=[\"query_id\", \"doc_id\"],\n",
        "        suffixes=(\"_bm25\", \"_monot5\"),\n",
        "        how=\"outer\"\n",
        "    ).fillna(0)\n",
        "\n",
        "    merged[\"hybrid_score\"] = (1-l) * merged[\"norm_score_bm25\"] + l * merged[\"norm_score_monot5\"]\n",
        "\n",
        "\n",
        "    eval_df = merged[[\"query_id\", \"doc_id\", \"hybrid_score\"]].rename(columns={\"hybrid_score\": \"score\"})\n",
        "    eval_df = eval_df.sort_values([\"query_id\", \"score\"], ascending=[True, False]).copy()\n",
        "    eval_df[\"rank\"] = eval_df.groupby(\"query_id\").cumcount() + 1\n",
        "\n",
        "\n",
        "    res = ir_measures.calc_aggregate(metrics, val_qrels_eval, eval_df)\n",
        "\n",
        "\n",
        "    log_data = {\n",
        "        \"lambda\": float(l),\n",
        "        \"nDCG@10\": res.get(nDCG@10, 0),\n",
        "        \"monot5_hybrid_nDCG@10\": res.get(nDCG@10, 0),\n",
        "        \"monot5_hybrid_nDCG@100\": res.get(nDCG@100, 0),\n",
        "        \"monot5_hybrid_nDCG@1000\": res.get(nDCG@1000, 0),\n",
        "        \"monot5_hybrid_RR@10\": res.get(RR@10, 0),\n",
        "        \"monot5_hybrid_Recall@10\": res.get(Recall@10, 0),\n",
        "        \"monot5_hybrid_Recall@100\": res.get(Recall@100, 0),\n",
        "        \"monot5_hybrid_Recall@500\": res.get(Recall@500, 0)\n",
        "    }\n",
        "\n",
        "    wandb.log(log_data)\n",
        "    run.finish()\n",
        "\n",
