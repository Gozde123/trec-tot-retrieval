    "def get_per_query_metric(qrels, run, metric):\n",
    "    results = list(ir_measures.iter_calc([metric], qrels, run))\n",
    "    return pd.Series(\n",
    "        {str(r.query_id): float(r.value) for r in results}\n",
    "    )\n",
    "\n",
    "\n",
    "def align_scores(scores_a, scores_b):\n",
    "    all_query_ids = scores_a.index.union(scores_b.index)\n",
    "\n",
    "    a = scores_a.reindex(all_query_ids).fillna(0).astype(float)\n",
    "    b = scores_b.reindex(all_query_ids).fillna(0).astype(float)\n",
    "\n",
    "    return a, b\n",
    "\n",
    "\n",
    "def wilcoxon_test(name_a, scores_a, name_b, scores_b):\n",
    "    scores_a, scores_b = align_scores(scores_a, scores_b)\n",
    "\n",
    "    stat, p_val = wilcoxon(\n",
    "        scores_a,\n",
    "        scores_b,\n",
    "        zero_method=\"zsplit\"\n",
    "    )\n",
    "\n",
    "    mean_a = scores_a.mean()\n",
    "    mean_b = scores_b.mean()\n",
    "\n",
    "    diff_pct = (\n",
    "        ((mean_b - mean_a) / mean_a) * 100\n",
    "        if mean_a != 0\n",
    "        else np.nan\n",
    "    )\n",
    "\n",
    "    return {\n",
    "        \"Comparison\": f\"{name_a} vs {name_b}\",\n",
    "        \"Mean A\": mean_a,\n",
    "        \"Mean B\": mean_b,\n",
    "        \"Diff %\": diff_pct,\n",
    "        \"Wilcoxon p-value\": p_val,\n",
    "        \"Significant\": p_val < 0.05\n",
    "    }\n",
    "\n",
    "\n",
    "\n",
    "metric_for_test = nDCG@10\n",
    "\n",
    "bm25_scores = get_per_query_metric(\n",
    "    val_qrels_eval,\n",
    "    bm25_val_run_eval,\n",
    "    metric_for_test\n",
    ")\n",
    "\n",
    "sbert_base_scores = get_per_query_metric(\n",
    "    val_qrels_eval,\n",
    "    sbert_val_run_eval,\n",
    "    metric_for_test\n",
    ")\n",
    "\n",
    "bge_base_scores = get_per_query_metric(\n",
    "    val_qrels_eval,\n",
    "    bge_val_run_eval,\n",
    "    metric_for_test\n",
    ")\n",
    "\n",
    "reranker_base_scores = get_per_query_metric(\n",
    "    val_qrels_eval,\n",
    "    cross_val_run_eval,\n",
    "    metric_for_test\n",
    ")\n",
    "\n",
    "monot5_base_scores = get_per_query_metric(\n",
    "    val_qrels_eval,\n",
    "    monoT5_val_run_eval,\n",
    "    metric_for_test\n",
    ")\n",
    "\n",
    "sbert_hyb_scores = get_per_query_metric(\n",
    "    val_qrels_eval,\n",
    "    sbert_hybrid_best_run,\n",
    "    metric_for_test\n",
    ")\n",
    "\n",
    "bge_hyb_scores = get_per_query_metric(\n",
    "    val_qrels_eval,\n",
    "    bge_hybrid_best_run,\n",
    "    metric_for_test\n",
    ")\n",
    "\n",
    "reranker_hyb_scores = get_per_query_metric(\n",
    "    val_qrels_eval,\n",
    "    bge_rr_hybrid_best_run,\n",
    "    metric_for_test\n",
    ")\n",
    "\n",
    "monot5_hyb_scores = get_per_query_metric(\n",
    "    val_qrels_eval,\n",
    "    monot5_hybrid_best_run,\n",
    "    metric_for_test\n",
    ")\n",
    "\n",
    "\n",
    "\n",
    "test_results = [\n",
    "    # Base vs Hybrid\n",
    "    wilcoxon_test(\"Base SBERT\", sbert_base_scores, \"Hybrid SBERT\", sbert_hyb_scores),\n",
    "    wilcoxon_test(\"Base BGE-M3\", bge_base_scores, \"Hybrid BGE-M3\", bge_hyb_scores),\n",
    "    wilcoxon_test(\"Base Reranker\", reranker_base_scores, \"Hybrid Reranker\", reranker_hyb_scores),\n",
    "    wilcoxon_test(\"Base MonoT5\", monot5_base_scores, \"Hybrid MonoT5\", monot5_hyb_scores),\n",
    "\n",
    "    # BM25 vs Hybrid\n",
    "    wilcoxon_test(\"BM25\", bm25_scores, \"Hybrid Reranker\", reranker_hyb_scores),\n",
    "    wilcoxon_test(\"BM25\", bm25_scores, \"Hybrid MonoT5\", monot5_hyb_scores),\n",
    "    wilcoxon_test(\"BM25\", bm25_scores, \"Hybrid SBERT\", sbert_hyb_scores),\n",
    "    wilcoxon_test(\"BM25\", bm25_scores, \"Hybrid BGE-M3\", bge_hyb_scores),\n",
    "\n",
    "    # Hybrid vs Hybrid\n",
    "    wilcoxon_test(\"Hybrid BGE-M3\", bge_hyb_scores, \"Hybrid MonoT5\", monot5_hyb_scores),\n",
    "    wilcoxon_test(\"Hybrid Reranker\", reranker_hyb_scores, \"Hybrid MonoT5\", monot5_hyb_scores),\n",
    "    wilcoxon_test(\"Hybrid SBERT\", sbert_hyb_scores, \"Hybrid MonoT5\", monot5_hyb_scores),\n",
    "    wilcoxon_test(\"Hybrid SBERT\", sbert_hyb_scores, \"Hybrid BGE-M3\", bge_hyb_scores)\n",
    "]\n",
    "\n",
    "wilcoxon_report_df = pd.DataFrame(test_results)\n",
    "\n",
    "print(\"\\nSTATISTICAL SIGNIFICANCE REPORT (Wilcoxon signed-rank test on per-query nDCG@10)\")\n",
    "display(wilcoxon_report_df)\n",
    "\n",
    "# Wilcoxon tests found that Hybrid SBERT and Hybrid BGE-M3 performed significantly better than BM25, while there was no significant difference between\n",
    "# Hybrid SBERT and Hybrid BGE-M3 (p=0.712).\n",
    "# Hybrid information retrieval is significantly more efficient compared to single-term or dense-based information retrieval when dealing with fuzzy ToT queries."
   ]
