      "source": [
        "torch.cuda.empty_cache()\n",
        "gc.collect()\n",
        "\n",
        "model_name = \"castorini/monot5-base-msmarco\"\n",
        "tokenizer = T5Tokenizer.from_pretrained(model_name)\n",
        "model = T5ForConditionalGeneration.from_pretrained(model_name).to(\"cuda\").eval()\n",
        "\n",
        "monot5_run_rows = []\n",
        "TOP_K_MONOT5 = 10000\n",
        "\n",
        "for i, (_, qrow) in enumerate(val_queries_pt.iterrows(), start=1):\n",
        "    qid = str(qrow[\"qid\"])\n",
        "    query_text = str(qrow[\"query\"])\n",
        "\n",
        "    cand_docs = bm25_val_candidates[bm25_val_candidates[\"query_id\"] == qid].head(TOP_K_MONOT5).copy()\n",
        "    cand_docs[\"text\"] = cand_docs[\"doc_id\"].map(doc_text_map).str.slice(0, 500)\n",
        "    cand_docs = cand_docs.dropna(subset=[\"text\"])\n",
        "\n",
        "    if len(cand_docs) == 0: continue\n",
        "\n",
        "\n",
        "    input_texts = [f\"Query: {query_text} Document: {txt} Relevant:\" for txt in cand_docs[\"text\"].tolist()]\n",
        "\n",
        "    scores = []\n",
        "    with torch.no_grad():\n",
        "\n",
        "        for j in range(0, len(input_texts), 32):\n",
        "            batch = input_texts[j:j+32]\n",
        "            inputs = tokenizer(batch, padding=True, truncation=True, max_length=512, return_tensors=\"pt\").to(\"cuda\")\n",
        "\n",
        "            outputs = model.generate(**inputs, max_new_tokens=1, return_dict_in_generate=True, output_scores=True)\n",
        "\n",
        "            res_scores = outputs.scores[0][:, 6136].cpu().numpy()\n",
        "            scores.extend(res_scores)\n",
        "\n",
        "    for idx, score in enumerate(scores):\n",
        "        monot5_run_rows.append({\n",
        "            \"query_id\": qid,\n",
        "            \"doc_id\": str(cand_docs.iloc[idx][\"doc_id\"]),\n",
        "            \"score\": float(score)\n",
        "        })\n",
        "\n",
        "    if i % 5 == 0: print(f\"Query {i} finished.\")\n",
        "\n",
        "monoT5_val_run_eval = pd.DataFrame(monot5_run_rows)"
      ]
    },
