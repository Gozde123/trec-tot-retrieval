    "for model_name, run_df in final_runs.items():\n",
    "    res = ir_measures.calc_aggregate(\n",
    "        [nDCG@10, nDCG@100, nDCG@1000, RR@10, Recall@10, Recall@100, Recall@500],\n",
    "        val_qrels_eval,\n",
    "        run_df\n",
    "    )\n",
    "\n",
    "    benchmark_rows.append({\n",
    "        \"Model\": model_name,\n",
    "        \"nDCG@10\": res[nDCG@10],\n",
    "        \"nDCG@100\": res[nDCG@100],\n",
    "        \"nDCG@1000\": res[nDCG@1000],\n",
    "        \"RR@10\": res[RR@10],\n",
    "        \"Recall@10\": res[Recall@10],\n",
    "        \"Recall@100\": res[Recall@100],\n",
    "        \"Recall@500\": res[Recall@500]\n",
    "    })\n",
    "\n",
    "final_benchmark_df = pd.DataFrame(benchmark_rows)\n",
