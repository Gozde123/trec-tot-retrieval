    "def rank_shift_analysis(bm25_run, hybrid_run):\n",
    "\n",
    "    bm25_ranks = bm25_run[[\"query_id\", \"doc_id\", \"rank\"]].rename(\n",
    "        columns={\"rank\": \"bm25_rank\"}\n",
    "    )\n",
    "\n",
    "    hybrid_ranks = hybrid_run[[\"query_id\", \"doc_id\", \"rank\"]].rename(\n",
    "        columns={\"rank\": \"hybrid_rank\"}\n",
    "    )\n",
    "\n",
    "    merged = bm25_ranks.merge(\n",
    "        hybrid_ranks,\n",
    "        on=[\"query_id\", \"doc_id\"],\n",
    "        how=\"inner\"\n",
    "    )\n",
    "\n",
    "    merged[\"rank_shift\"] = (\n",
    "        merged[\"bm25_rank\"] - merged[\"hybrid_rank\"]\n",
    "    )\n",
    "\n",
    "    display(\n",
    "        merged[\"rank_shift\"].describe()\n",
    "    )\n",
    "\n",
    "    return merged\n",
    "\n",
    "\n",
    "rank_shift_df = rank_shift_analysis(\n",
    "    bm25_val_run_eval,\n",
    "    sbert_hybrid_best_run\n",
    ")\n",
    "\n",
    "\n",
    "# Based on the results of the rank shift test, it can be concluded that the use of the hybrid approach significantly changed the ranking produced by BM25.\n",
    "# The change in position for the documents averaged 190."
   ]
