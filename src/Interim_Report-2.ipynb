      "source": [
        "torch.cuda.empty_cache()\n",
        "gc.collect()\n",
        "\n",
        "sbert_model = SentenceTransformer(\"all-mpnet-base-v2\", device=\"cuda\")\n",
        "\n",
        "sbert_run_rows = []\n",
        "TOP_K_SBERT = 10000\n",
        "\n",
        "\n",
        "for i, (_, qrow) in enumerate(val_queries_pt.iterrows(), start=1):\n",
        "    qid = str(qrow[\"qid\"])\n",
        "    query_text = str(qrow[\"query\"])\n",
        "\n",
        "    cand_docs = bm25_val_candidates[bm25_val_candidates[\"query_id\"] == qid].head(TOP_K_SBERT).copy()\n",
        "    cand_docs[\"text\"] = cand_docs[\"doc_id\"].map(doc_text_map)\n",
        "    cand_docs = cand_docs.dropna(subset=[\"text\"])\n",
        "\n",
        "    if len(cand_docs) == 0: continue\n",
        "\n",
        "    # SBERT Encoding\n",
        "    query_emb = sbert_model.encode([query_text], convert_to_numpy=True)\n",
        "    doc_embs = sbert_model.encode(cand_docs[\"text\"].tolist(), batch_size=64, show_progress_bar=False)\n",
        "\n",
        "    # Cosine similarity\n",
        "    scores = np.dot(doc_embs, query_emb.T).flatten()\n",
        "\n",
        "    for idx, score in enumerate(scores):\n",
        "        sbert_run_rows.append({\n",
        "            \"query_id\": qid,\n",
        "            \"doc_id\": str(cand_docs.iloc[idx][\"doc_id\"]),\n",
        "            \"score\": float(score)\n",
        "        })\n",
        "\n",
        "    if i % 5 == 0: print(f\"Query {i} finished.\")\n",
        "\n",
        "sbert_val_run_eval = pd.DataFrame(sbert_run_rows)"
      ]
    },
