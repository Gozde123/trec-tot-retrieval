    "train_qrels_df = qrels_train_2024.copy()\n",
    "val_qrels_df = qrels_val_2024.copy()\n",
    "test_qrels_df = qrels_test_2024.copy()\n",
    "\n",
    "def clean_query(text):\n",
    "    text = str(text).lower()\n",
    "    text = re.sub(r\"\\s+\", \" \", text)\n",
    "    return text.strip()\n",
    "\n",
    "train_queries_df[\"query\"] = train_queries_df[\"query\"].apply(clean_query)\n",
    "val_queries_df[\"query\"] = val_queries_df[\"query\"].apply(clean_query)\n",
    "test_queries_df[\"query\"] = test_queries_df[\"query\"].apply(clean_query)\n",
    "\n",
    "val_queries_pt = val_queries_df.rename(columns={\"query_id\": \"qid\"})\n",
    "val_queries_pt[\"qid\"] = val_queries_pt[\"qid\"].astype(str)\n",
    "val_queries_pt[\"query\"] = val_queries_pt[\"query\"].astype(str)\n",
    "val_queries_pt = val_queries_pt[[\"qid\", \"query\"]]\n",
    "\n",
    "display(val_queries_pt.head())"
