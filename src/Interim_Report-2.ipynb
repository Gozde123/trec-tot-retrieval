        "torch.cuda.empty_cache()\n",
        "gc.collect()\n",
        "\n",
        "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
        "bge_model = SentenceTransformer(\"BAAI/bge-m3\", device=device)\n",
        "\n",
        "TOP_K_RERANK = 10000\n",
        "CHUNK_SIZE = 64\n",
        "\n",
        "bge_run_rows = []\n",
        "\n",
        "print(\"BGE-M3 Rerank\")\n",
        "\n",
        "for i, (_, qrow) in enumerate(val_queries_pt.iterrows(), start=1):\n",
        "    qid = str(qrow[\"qid\"])\n",
        "    query_text = str(qrow[\"query\"])\n",
        "\n",
        "    cand_docs = bm25_val_candidates[bm25_val_candidates[\"query_id\"] == qid].copy()\n",
        "    cand_docs = cand_docs.head(TOP_K_RERANK)\n",
        "\n",
        "    cand_docs[\"text\"] = cand_docs[\"doc_id\"].map(doc_text_map).str.slice(0, 500)\n",
        "    cand_docs = cand_docs.dropna(subset=[\"text\"])\n",
        "\n",
        "    if len(cand_docs) == 0: continue\n",
        "\n",
        "    # query embedding\n",
        "    query_emb = bge_model.encode([query_text], convert_to_numpy=True, normalize_embeddings=True)[0]\n",
        "    texts = cand_docs[\"text\"].tolist()\n",
        "\n",
        "    try:\n",
        "        with torch.no_grad():\n",
        "            # Batch embedding\n",
        "            doc_embs = bge_model.encode(\n",
        "                texts,\n",
        "                batch_size=CHUNK_SIZE,\n",
        "                show_progress_bar=False,\n",
        "                convert_to_numpy=True,\n",
        "                normalize_embeddings=True\n",
        "            )\n",
        "\n",
        "        # Score\n",
        "        all_scores = np.dot(doc_embs, query_emb)\n",
        "\n",
        "        cand_docs[\"score\"] = all_scores\n",
        "        cand_docs = cand_docs.sort_values(\"score\", ascending=False).reset_index(drop=True)\n",
        "        cand_docs[\"rank\"] = np.arange(1, len(cand_docs) + 1)\n",
        "\n",
        "        for _, row in cand_docs.iterrows():\n",
        "            bge_run_rows.append({\n",
        "                \"query_id\": qid,\n",
        "                \"doc_id\": str(row[\"doc_id\"]),\n",
        "                \"score\": float(row[\"score\"]),\n",
        "                \"rank\": int(row[\"rank\"])\n",
        "            })\n",
        "\n",
        "        del doc_embs, all_scores, texts\n",
        "\n",
        "    except RuntimeError as e:\n",
        "        if \"out of memory\" in str(e):\n",
        "            print(f\"!!! OOM at Query {i} ({qid}), cleaning cache and skipping...\")\n",
        "            torch.cuda.empty_cache()\n",
        "            gc.collect()\n",
        "            continue\n",
        "        else:\n",
        "            raise e\n",
        "\n",
        "    if i % 5 == 0:\n",
        "        print(f\"Query {i}/{len(val_queries_pt)} finished.\")\n",
        "        torch.cuda.empty_cache()\n",
        "        gc.collect()\n",
        "\n",
        "bge_val_run_eval = pd.DataFrame(bge_run_rows)"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "def normalize_per_query(df):\n",
        "    df = df.copy()\n",
        "    mn, mx = df[\"score\"].min(), df[\"score\"].max()\n",
        "    df[\"norm_score\"] = 0.0 if mx == mn else (df[\"score\"] - mn) / (mx - mn)\n",
        "    return df\n",
        "\n",
        "# Normalizasyon\n",
        "bm25_norm = bm25_val_candidates.copy().groupby(\"query_id\", group_keys=False).apply(normalize_per_query)\n",
        "bge_norm = bge_val_run_eval.copy().groupby(\"query_id\", group_keys=False).apply(normalize_per_query)\n",
        "\n",
        "bge_hybrid_runs = []\n",
        "bge_hybrid_run_dict = {}\n",
        "\n",
        "for l in lambda_values:\n",
        "    run = wandb.init(\n",
        "        project=\"trec-tot-hybrid-final\",\n",
        "        name=f\"BGE-M3_Lambda_{l:.1f}_20k\",\n",
        "        id=f\"bge_m3_sweep_{int(l*10)}_{int(time.time())}\",\n",
        "        reinit=True\n",
        "    )\n",
        "\n",
        "    merged = pd.merge(\n",
        "        bm25_norm[[\"query_id\", \"doc_id\", \"norm_score\"]],\n",
        "        bge_norm[[\"query_id\", \"doc_id\", \"norm_score\"]],\n",
        "        on=[\"query_id\", \"doc_id\"],\n",
        "        how=\"outer\",\n",
        "        suffixes=(\"_bm25\", \"_bge\")\n",
        "    )\n",
        "\n",
        "    merged[\"norm_score_bm25\"] = merged[\"norm_score_bm25\"].fillna(0)\n",
        "    merged[\"norm_score_bge\"] = merged[\"norm_score_bge\"].fillna(0)\n",
        "\n",
        "    # (1-L)*BM25 + L*BGE\n",
        "    merged[\"score\"] = (1 - l) * merged[\"norm_score_bm25\"] + l * merged[\"norm_score_bge\"]\n",
        "\n",
        "    eval_df = (\n",
        "        merged[[\"query_id\", \"doc_id\", \"score\"]]\n",
        "        .sort_values([\"query_id\", \"score\"], ascending=[True, False])\n",
        "        .copy()\n",
        "    )\n",
        "\n",
        "    eval_df[\"rank\"] = eval_df.groupby(\"query_id\").cumcount() + 1\n",
        "    eval_df = eval_df[[\"query_id\", \"doc_id\", \"score\", \"rank\"]]\n",
        "\n",
        "    res = ir_measures.calc_aggregate(metrics, val_qrels_eval, eval_df)\n",
        "\n",
        "    row = {\n",
        "        \"model\": \"BGE-M3\",\n",
        "        \"candidate_size\": 10000,\n",
        "        \"lambda\": float(l),\n",
        "        \"nDCG@10\": res[nDCG@10],\n",
        "        \"nDCG@100\": res[nDCG@100],\n",
        "        \"nDCG@1000\": res[nDCG@1000],\n",
        "        \"RR@10\": res[RR@10],\n",
        "        \"Recall@10\": res[Recall@10],\n",
        "        \"Recall@100\": res[Recall@100],\n",
        "        \"Recall@500\": res[Recall@500]\n",
        "    }\n",
        "\n",
        "    wandb.log(row)\n",
        "    run.finish()\n",
        "\n",
        "    bge_hybrid_runs.append(row)\n",
        "    bge_hybrid_run_dict[float(l)] = eval_df.copy()\n",
        "\n",
        "bge_wb_df = pd.DataFrame(bge_hybrid_runs)\n",
        "display(bge_wb_df.sort_values(\"nDCG@10\", ascending=False))"
      ],
