   ],
   "source": [
    "\n",
    "torch.cuda.empty_cache()\n",
    "gc.collect()\n",
    "\n",
    "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
    "\n",
    "model_name = \"castorini/monot5-base-msmarco\"\n",
    "\n",
    "tokenizer = T5Tokenizer.from_pretrained(model_name)\n",
    "model = T5ForConditionalGeneration.from_pretrained(model_name).to(device).eval()\n",
    "\n",
    "metrics = [\n",
    "    nDCG@10, nDCG@100, nDCG@1000,\n",
    "    RR@10,\n",
    "    Recall@10, Recall@100, Recall@500\n",
    "]\n",
    "\n",
    "candidate_size_probe = 500\n",
    "candidate_size_full = 5000\n",
    "\n",
    "batch_size = 32\n",
    "doc_max_chars = 700\n",
    "\n",
    "max_length_values = [256, 384, 512]\n",
    "lambda_values = np.arange(0.0, 1.01, 0.1)\n",
    "\n",
    "probe_queries = val_queries_pt.head(40).copy()\n",
    "\n",
    "instruction_templates = {\n",
    "    \"none\": \"Query: {query} Document: {doc} Relevant:\",\n",
    "    \"tot\": \"Find the document that best matches this vague tip-of-the-tongue query. Query: {query} Document: {doc} Relevant:\",\n",
    "    \"semantic\": \"Retrieve the most semantically relevant document for this incomplete memory-based query. Query: {query} Document: {doc} Relevant:\",\n",
    "    \"memory\": \"This is a memory-based incomplete query. Rank whether the document semantically matches it. Query: {query} Document: {doc} Relevant:\"\n",
    "}\n",
    "\n",
    "\n",
    "def normalize_per_query(df):\n",
    "    df = df.copy()\n",
    "    mn = df[\"score\"].min()\n",
    "    mx = df[\"score\"].max()\n",
    "\n",
    "    if mn == mx:\n",
    "        df[\"norm_score\"] = 0.0\n",
    "    else:\n",
    "        df[\"norm_score\"] = (df[\"score\"] - mn) / (mx - mn)\n",
    "\n",
    "    return df\n",
    "\n",
    "\n",
    "def build_monot5_run(\n",
    "    queries_df,\n",
    "    bm25_df,\n",
    "    candidate_size,\n",
    "    max_length,\n",
    "    instruction_name,\n",
    "    instruction_template\n",
    "):\n",
    "    mono_rows = []\n",
    "\n",
    "    bm25_topk = (\n",
    "        bm25_df\n",
    "        .sort_values([\"query_id\", \"rank\"], ascending=[True, True])\n",
    "        .groupby(\"query_id\", group_keys=False)\n",
    "        .head(candidate_size)\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "    bm25_topk[\"query_id\"] = bm25_topk[\"query_id\"].astype(str)\n",
    "    bm25_topk[\"doc_id\"] = bm25_topk[\"doc_id\"].astype(str)\n",
    "\n",
    "    query_ids = set(queries_df[\"qid\"].astype(str))\n",
    "    bm25_topk = bm25_topk[bm25_topk[\"query_id\"].isin(query_ids)].copy()\n",
    "\n",
    "    print(f\"Candidate size: {candidate_size}\")\n",
    "    print(f\"Max length: {max_length}\")\n",
    "    print(f\"Instruction: {instruction_name}\")\n",
    "\n",
    "    true_token_id = tokenizer.encode(\"true\", add_special_tokens=False)[0]\n",
    "\n",
    "    for i, (_, qrow) in enumerate(queries_df.iterrows(), start=1):\n",
    "\n",
    "        qid = str(qrow[\"qid\"])\n",
    "        query_text = str(qrow[\"query\"])\n",
    "\n",
    "        cand_docs = (\n",
    "            bm25_topk[bm25_topk[\"query_id\"] == qid]\n",
    "            .sort_values(\"rank\")\n",
    "            .head(candidate_size)\n",
    "            .copy()\n",
    "        )\n",
    "\n",
    "        cand_docs[\"text\"] = cand_docs[\"doc_id\"].map(doc_text_map)\n",
    "        cand_docs = cand_docs.dropna(subset=[\"text\"])\n",
    "\n",
    "        if len(cand_docs) == 0:\n",
    "            continue\n",
    "\n",
    "        input_texts = [\n",
    "            instruction_template.format(\n",
    "                query=query_text,\n",
    "                doc=str(text)[:doc_max_chars]\n",
    "            )\n",
    "            for text in cand_docs[\"text\"].tolist()\n",
    "        ]\n",
    "\n",
    "        scores = []\n",
    "\n",
    "        for start in range(0, len(input_texts), batch_size):\n",
    "\n",
    "            batch = input_texts[start:start + batch_size]\n",
    "\n",
    "            inputs = tokenizer(\n",
    "                batch,\n",
    "                padding=True,\n",
    "                truncation=True,\n",
    "                max_length=max_length,\n",
    "                return_tensors=\"pt\"\n",
    "            ).to(device)\n",
    "\n",
    "            decoder_input_ids = torch.full(\n",
    "                (inputs[\"input_ids\"].shape[0], 1),\n",
    "                model.config.decoder_start_token_id,\n",
    "                dtype=torch.long,\n",
    "                device=device\n",
    "            )\n",
    "\n",
    "            with torch.no_grad():\n",
    "                outputs = model(\n",
    "                    **inputs,\n",
    "                    decoder_input_ids=decoder_input_ids\n",
    "                )\n",
    "\n",
    "                logits = outputs.logits[:, 0, :]\n",
    "                batch_scores = logits[:, true_token_id].float().detach().cpu().numpy()\n",
    "                scores.extend(batch_scores)\n",
    "\n",
    "            del inputs, decoder_input_ids, outputs, logits\n",
    "\n",
    "            if device == \"cuda\":\n",
    "                torch.cuda.empty_cache()\n",
    "\n",
    "        cand_docs[\"score\"] = scores\n",
    "\n",
    "        cand_docs = (\n",
    "            cand_docs\n",
    "            .sort_values(\"score\", ascending=False)\n",
    "            .reset_index(drop=True)\n",
    "        )\n",
    "\n",
    "        cand_docs[\"rank\"] = np.arange(1, len(cand_docs) + 1)\n",
    "\n",
    "        mono_rows.extend(\n",
    "            cand_docs[[\"query_id\", \"doc_id\", \"score\", \"rank\"]].to_dict(\"records\")\n",
    "        )\n",
    "\n",
    "        if i % 5 == 0:\n",
    "            print(f\"Processed {i}/{len(queries_df)} queries\")\n",
    "\n",
    "    mono_run = pd.DataFrame(mono_rows)\n",
    "\n",
    "    torch.cuda.empty_cache()\n",
    "    gc.collect()\n",
    "\n",
    "    return mono_run\n",
    "\n",
    "\n",
    "\n",
    "probe_results = []\n",
    "\n",
    "for instruction_name, instruction_template in instruction_templates.items():\n",
    "\n",
    "    for max_length in max_length_values:\n",
    "\n",
    "        print(f\"\\nPROBE: MonoT5 instruction={instruction_name}, max_length={max_length}\")\n",
    "\n",
    "        mono_probe = build_monot5_run(\n",
    "            queries_df=probe_queries,\n",
    "            bm25_df=bm25_val_candidates,\n",
    "            candidate_size=candidate_size_probe,\n",
    "            max_length=max_length,\n",
    "            instruction_name=instruction_name,\n",
    "            instruction_template=instruction_template\n",
    "        )\n",
    "\n",
    "        if mono_probe.empty:\n",
    "            continue\n",
    "\n",
    "        res = ir_measures.calc_aggregate(\n",
    "            [nDCG@10, RR@10, Recall@10],\n",
    "            val_qrels_eval,\n",
    "            mono_probe\n",
    "        )\n",
    "\n",
    "        row = {\n",
    "            \"stage\": \"instruction_max_length_probe\",\n",
    "            \"model\": \"MonoT5\",\n",
    "            \"candidate_size\": candidate_size_probe,\n",
    "            \"num_probe_queries\": len(probe_queries),\n",
    "            \"instruction_name\": instruction_name,\n",
    "            \"max_length\": max_length,\n",
    "            \"lambda\": 1.0,\n",
    "            \"nDCG@10\": res[nDCG@10],\n",
    "            \"RR@10\": res[RR@10],\n",
    "            \"Recall@10\": res[Recall@10]\n",
    "        }\n",
    "\n",
    "        run = wandb.init(\n",
    "            project=\"trec-tot-hybrid-final\",\n",
    "            name=f\"MonoT5_Probe_{instruction_name}_MaxLen_{max_length}_500_40q\",\n",
    "            config=row,\n",
    "            reinit=True\n",
    "        )\n",
    "\n",
    "        wandb.log(row)\n",
    "        run.finish()\n",
    "\n",
    "        probe_results.append(row)\n",
    "\n",
    "\n",
    "probe_df = pd.DataFrame(probe_results)\n",
    "\n",
    "display(\n",
    "    probe_df.sort_values(\"nDCG@10\", ascending=False)\n",
    ")\n",
    "\n",
    "best_probe = probe_df.sort_values(\"nDCG@10\", ascending=False).iloc[0]\n",
    "\n",
    "best_instruction_name = best_probe[\"instruction_name\"]\n",
    "best_instruction_template = instruction_templates[best_instruction_name]\n",
    "best_max_length = int(best_probe[\"max_length\"])\n",
    "\n",
    "print(\"\\nSELECTED PROBE CONFIGURATION\")\n",
    "print(f\"Best instruction: {best_instruction_name}\")\n",
    "print(f\"Best max_length: {best_max_length}\")\n",
    "print(f\"Probe nDCG@10: {best_probe['nDCG@10']}\")\n",
    "\n",
    "\n",
    "print(\n",
    "    f\"\\nFULL RUN: MonoT5 instruction={best_instruction_name}, \"\n",
    "    f\"max_length={best_max_length}, candidate_size={candidate_size_full}\"\n",
    ")\n",
    "\n",
    "monoT5_val_run_eval = build_monot5_run(\n",
    "    queries_df=val_queries_pt,\n",
    "    bm25_df=bm25_val_candidates,\n",
    "    candidate_size=candidate_size_full,\n",
    "    max_length=best_max_length,\n",
    "    instruction_name=best_instruction_name,\n",
    "    instruction_template=best_instruction_template\n",
    ")\n",
    "\n",
    "monot5_norm = (\n",
    "    monoT5_val_run_eval\n",
    "    .groupby(\"query_id\", group_keys=False)\n",
    "    .apply(normalize_per_query)\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "bm25_topk_full = (\n",
    "    bm25_val_candidates\n",
    "    .sort_values([\"query_id\", \"rank\"], ascending=[True, True])\n",
    "    .groupby(\"query_id\", group_keys=False)\n",
    "    .head(candidate_size_full)\n",
    "    .copy()\n",
    ")\n",
    "\n",
    "bm25_topk_full[\"query_id\"] = bm25_topk_full[\"query_id\"].astype(str)\n",
    "bm25_topk_full[\"doc_id\"] = bm25_topk_full[\"doc_id\"].astype(str)\n",
    "\n",
    "bm25_norm = (\n",
    "    bm25_topk_full\n",
    "    .groupby(\"query_id\", group_keys=False)\n",
    "    .apply(normalize_per_query)\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "\n",
    "\n",
    "monot5_hybrid_runs = []\n",
    "monot5_hybrid_run_dict = {}\n",
    "\n",
    "for l in lambda_values:\n",
    "\n",
    "    merged = pd.merge(\n",
    "        bm25_norm[[\"query_id\", \"doc_id\", \"norm_score\"]],\n",
    "        monot5_norm[[\"query_id\", \"doc_id\", \"norm_score\"]],\n",
    "        on=[\"query_id\", \"doc_id\"],\n",
    "        how=\"outer\",\n",
    "        suffixes=(\"_bm25\", \"_monot5\")\n",
    "    )\n",
    "\n",
    "    merged[\"norm_score_bm25\"] = merged[\"norm_score_bm25\"].fillna(0)\n",
    "    merged[\"norm_score_monot5\"] = merged[\"norm_score_monot5\"].fillna(0)\n",
    "\n",
    "    merged[\"score\"] = (\n",
    "        (1 - l) * merged[\"norm_score_bm25\"]\n",
    "        + l * merged[\"norm_score_monot5\"]\n",
    "    )\n",
    "\n",
    "    eval_df = (\n",
    "        merged[[\"query_id\", \"doc_id\", \"score\"]]\n",
    "        .sort_values([\"query_id\", \"score\"], ascending=[True, False])\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "    eval_df[\"rank\"] = eval_df.groupby(\"query_id\").cumcount() + 1\n",
    "    eval_df = eval_df[[\"query_id\", \"doc_id\", \"score\", \"rank\"]]\n",
    "\n",
    "    res = ir_measures.calc_aggregate(\n",
    "        metrics,\n",
    "        val_qrels_eval,\n",
    "        eval_df\n",
    "    )\n",
    "\n",
    "    row = {\n",
    "        \"stage\": \"full_lambda_tuning\",\n",
    "        \"model\": \"MonoT5\",\n",
    "        \"candidate_size\": candidate_size_full,\n",
    "        \"selected_instruction\": best_instruction_name,\n",
    "        \"selected_max_length\": best_max_length,\n",
    "        \"doc_max_chars\": doc_max_chars,\n",
    "        \"lambda\": float(l),\n",
    "\n",
    "        \"nDCG@10\": res[nDCG@10],\n",
    "        \"nDCG@100\": res[nDCG@100],\n",
    "        \"nDCG@1000\": res[nDCG@1000],\n",
    "        \"RR@10\": res[RR@10],\n",
    "        \"Recall@10\": res[Recall@10],\n",
    "        \"Recall@100\": res[Recall@100],\n",
    "        \"Recall@500\": res[Recall@500]\n",
    "    }\n",
    "\n",
    "    run = wandb.init(\n",
    "        project=\"trec-tot-hybrid-final\",\n",
    "        name=f\"MonoT5_{best_instruction_name}_Lambda_{l:.1f}_MaxLen_{best_max_length}_{candidate_size_full}\",\n",
    "        config=row,\n",
    "        reinit=True\n",
    "    )\n",
    "\n",
    "    wandb.log(row)\n",
    "    run.finish()\n",
    "\n",
    "    monot5_hybrid_runs.append(row)\n",
    "    monot5_hybrid_run_dict[float(l)] = eval_df.copy()\n",
    "\n",
    "\n",
    "monot5_wb_df = pd.DataFrame(monot5_hybrid_runs)\n",
    "\n",
    "display(\n",
    "    monot5_wb_df.sort_values(\"nDCG@10\", ascending=False)\n",
    ")\n",
    "\n",
    "best_idx = monot5_wb_df[\"nDCG@10\"].idxmax()\n",
    "\n",
    "monot5_best_l = float(monot5_wb_df.loc[best_idx, \"lambda\"])\n",
    "monot5_best_score = float(monot5_wb_df.loc[best_idx, \"nDCG@10\"])\n",
    "\n",
    "monot5_hybrid_best_run = monot5_hybrid_run_dict[monot5_best_l].copy()\n",
    "\n",
    "base_row = monot5_wb_df[monot5_wb_df[\"lambda\"] == 1.0]\n",
    "\n",
    "if not base_row.empty:\n",
    "    monot5_base_score = float(base_row.iloc[0][\"nDCG@10\"])\n",
    "else:\n",
    "    monot5_base_score = None\n",
    "\n",
    "print(\"\\nMonoT5 BEST CONFIGURATION\")\n",
    "print(f\"Selected instruction: {best_instruction_name}\")\n",
    "print(f\"Selected max_length: {best_max_length}\")\n",
    "print(f\"Base lambda=1.0 nDCG@10: {monot5_base_score}\")\n",
    "print(f\"Best lambda: {monot5_best_l}\")\n",
    "print(f\"Best nDCG@10: {monot5_best_score}\")\n",
    "\n",
    "\n",
    "# For MonoT5, the best configuration included the semantic instruction, max_length = 384, and λ = 0.1, producing nDCG@10 = 0.0820.\n",
    "# Thus, we conclude that MonoT5 performed slightly better than BM25."
   ]
  },
