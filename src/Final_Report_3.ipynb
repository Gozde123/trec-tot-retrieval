   "source": [
    "torch.cuda.empty_cache()\n",
    "gc.collect()\n",
    "\n",
    "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
    "\n",
    "model_name = \"BAAI/bge-reranker-v2-m3\"\n",
    "\n",
    "tokenizer = AutoTokenizer.from_pretrained(model_name)\n",
    "\n",
    "model = AutoModelForSequenceClassification.from_pretrained(\n",
    "    model_name,\n",
    "    torch_dtype=torch.float16 if device == \"cuda\" else torch.float32\n",
    ").to(device).eval()\n",
    "\n",
    "metrics = [\n",
    "    nDCG@10, nDCG@100, nDCG@1000,\n",
    "    RR@10,\n",
    "    Recall@10, Recall@100, Recall@500\n",
    "]\n",
    "\n",
    "candidate_size_probe = 500\n",
    "candidate_size_full = 5000\n",
    "\n",
    "batch_size = 128\n",
    "doc_max_chars = 700\n",
    "\n",
    "max_length_values = [256, 384, 512]\n",
    "lambda_values = np.arange(0.0, 1.01, 0.1)\n",
    "\n",
    "probe_queries = val_queries_pt.head(40).copy()\n",
    "\n",
    "instruction_templates = {\n",
    "    \"none\": \"{query}\",\n",
    "    \"tot\": \"Find the document that best matches this vague tip-of-the-tongue query: {query}\",\n",
    "    \"semantic\": \"Retrieve the most semantically relevant document for this incomplete memory-based query: {query}\",\n",
    "    \"memory\": \"This is a memory-based incomplete query. Rank the document by semantic match: {query}\"\n",
    "}\n",
    "\n",
    "\n",
    "def normalize_per_query(df):\n",
    "    df = df.copy()\n",
    "    mn = df[\"score\"].min()\n",
    "    mx = df[\"score\"].max()\n",
    "\n",
    "    if mn == mx:\n",
    "        df[\"norm_score\"] = 0.0\n",
    "    else:\n",
    "        df[\"norm_score\"] = (df[\"score\"] - mn) / (mx - mn)\n",
    "\n",
    "    return df\n",
    "\n",
    "\n",
    "def build_cross_encoder_run(\n",
    "    queries_df,\n",
    "    bm25_df,\n",
    "    candidate_size,\n",
    "    max_length,\n",
    "    instruction_name,\n",
    "    instruction_template\n",
    "):\n",
    "    cross_rows = []\n",
    "\n",
    "    bm25_topk = (\n",
    "        bm25_df\n",
    "        .sort_values([\"query_id\", \"rank\"], ascending=[True, True])\n",
    "        .groupby(\"query_id\", group_keys=False)\n",
    "        .head(candidate_size)\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "    bm25_topk[\"query_id\"] = bm25_topk[\"query_id\"].astype(str)\n",
    "    bm25_topk[\"doc_id\"] = bm25_topk[\"doc_id\"].astype(str)\n",
    "\n",
    "    query_ids = set(queries_df[\"qid\"].astype(str))\n",
    "    bm25_topk = bm25_topk[bm25_topk[\"query_id\"].isin(query_ids)].copy()\n",
    "\n",
    "    print(f\"Candidate size: {candidate_size}\")\n",
    "    print(f\"Max length: {max_length}\")\n",
    "    print(f\"Instruction: {instruction_name}\")\n",
    "\n",
    "    for i, (_, qrow) in enumerate(queries_df.iterrows(), start=1):\n",
    "\n",
    "        qid = str(qrow[\"qid\"])\n",
    "        raw_query = str(qrow[\"query\"])\n",
    "        query_text = instruction_template.format(query=raw_query)\n",
    "\n",
    "        cand_docs = (\n",
    "            bm25_topk[bm25_topk[\"query_id\"] == qid]\n",
    "            .sort_values(\"rank\")\n",
    "            .head(candidate_size)\n",
    "            .copy()\n",
    "        )\n",
    "\n",
    "        cand_docs[\"text\"] = cand_docs[\"doc_id\"].map(doc_text_map)\n",
    "        cand_docs = cand_docs.dropna(subset=[\"text\"])\n",
    "\n",
    "        if len(cand_docs) == 0:\n",
    "            continue\n",
    "\n",
    "        pairs = [\n",
    "            [query_text, str(text)[:doc_max_chars]]\n",
    "            for text in cand_docs[\"text\"].tolist()\n",
    "        ]\n",
    "\n",
    "        all_scores = []\n",
    "\n",
    "        for start in range(0, len(pairs), batch_size):\n",
    "\n",
    "            batch_pairs = pairs[start:start + batch_size]\n",
    "\n",
    "            inputs = tokenizer(\n",
    "                batch_pairs,\n",
    "                padding=True,\n",
    "                truncation=True,\n",
    "                return_tensors=\"pt\",\n",
    "                max_length=max_length\n",
    "            ).to(device)\n",
    "\n",
    "            with torch.no_grad():\n",
    "                logits = model(**inputs).logits.view(-1).float()\n",
    "                all_scores.extend(logits.detach().cpu().numpy())\n",
    "\n",
    "            del inputs, logits\n",
    "\n",
    "            if device == \"cuda\":\n",
    "                torch.cuda.empty_cache()\n",
    "\n",
    "        cand_docs[\"score\"] = all_scores\n",
    "\n",
    "        cand_docs = (\n",
    "            cand_docs\n",
    "            .sort_values(\"score\", ascending=False)\n",
    "            .reset_index(drop=True)\n",
    "        )\n",
    "\n",
    "        cand_docs[\"rank\"] = np.arange(1, len(cand_docs) + 1)\n",
    "\n",
    "        cross_rows.extend(\n",
    "            cand_docs[[\"query_id\", \"doc_id\", \"score\", \"rank\"]].to_dict(\"records\")\n",
    "        )\n",
    "\n",
    "        if i % 5 == 0:\n",
    "            print(f\"Processed {i}/{len(queries_df)} queries\")\n",
    "\n",
    "    cross_run = pd.DataFrame(cross_rows)\n",
    "\n",
    "    torch.cuda.empty_cache()\n",
    "    gc.collect()\n",
    "\n",
    "    return cross_run\n",
    "\n",
    "\n",
    "probe_results = []\n",
    "\n",
    "for instruction_name, instruction_template in instruction_templates.items():\n",
    "\n",
    "    for max_length in max_length_values:\n",
    "\n",
    "        print(f\"\\nPROBE: instruction={instruction_name}, max_length={max_length}\")\n",
    "\n",
    "        cross_probe = build_cross_encoder_run(\n",
    "            queries_df=probe_queries,\n",
    "            bm25_df=bm25_val_candidates,\n",
    "            candidate_size=candidate_size_probe,\n",
    "            max_length=max_length,\n",
    "            instruction_name=instruction_name,\n",
    "            instruction_template=instruction_template\n",
    "        )\n",
    "\n",
    "        if cross_probe.empty:\n",
    "            continue\n",
    "\n",
    "        res = ir_measures.calc_aggregate(\n",
    "            [nDCG@10, RR@10, Recall@10],\n",
    "            val_qrels_eval,\n",
    "            cross_probe\n",
    "        )\n",
    "\n",
    "        row = {\n",
    "            \"stage\": \"instruction_max_length_probe\",\n",
    "            \"model\": \"BGE-Reranker-v2-m3\",\n",
    "            \"candidate_size\": candidate_size_probe,\n",
    "            \"num_probe_queries\": len(probe_queries),\n",
    "            \"instruction_name\": instruction_name,\n",
    "            \"max_length\": max_length,\n",
    "            \"lambda\": 1.0,\n",
    "            \"nDCG@10\": res[nDCG@10],\n",
    "            \"RR@10\": res[RR@10],\n",
    "            \"Recall@10\": res[Recall@10]\n",
    "        }\n",
    "\n",
    "        run = wandb.init(\n",
    "            project=\"trec-tot-hybrid-final\",\n",
    "            name=f\"BGE_RR_Probe_{instruction_name}_MaxLen_{max_length}_2k_40q\",\n",
    "            config=row,\n",
    "            reinit=True\n",
    "        )\n",
    "\n",
    "        wandb.log(row)\n",
    "        run.finish()\n",
    "\n",
    "        probe_results.append(row)\n",
    "\n",
    "\n",
    "probe_df = pd.DataFrame(probe_results)\n",
    "\n",
    "display(\n",
    "    probe_df.sort_values(\"nDCG@10\", ascending=False)\n",
    ")\n",
    "\n",
    "best_probe = probe_df.sort_values(\"nDCG@10\", ascending=False).iloc[0]\n",
    "\n",
    "best_instruction_name = best_probe[\"instruction_name\"]\n",
    "best_instruction_template = instruction_templates[best_instruction_name]\n",
    "best_max_length = int(best_probe[\"max_length\"])\n",
    "\n",
    "print(\"\\nSELECTED PROBE CONFIGURATION\")\n",
    "print(f\"Best instruction: {best_instruction_name}\")\n",
    "print(f\"Best max_length: {best_max_length}\")\n",
    "print(f\"Probe nDCG@10: {best_probe['nDCG@10']}\")\n",
    "\n",
    "\n",
    "\n",
    "print(\n",
    "    f\"\\nFULL RUN: BGE-Reranker instruction={best_instruction_name}, \"\n",
    "    f\"max_length={best_max_length}, candidate_size={candidate_size_full}\"\n",
    ")\n",
    "\n",
    "cross_val_run_eval = build_cross_encoder_run(\n",
    "    queries_df=val_queries_pt,\n",
    "    bm25_df=bm25_val_candidates,\n",
    "    candidate_size=candidate_size_full,\n",
    "    max_length=best_max_length,\n",
    "    instruction_name=best_instruction_name,\n",
    "    instruction_template=best_instruction_template\n",
    ")\n",
    "\n",
    "cross_norm = (\n",
    "    cross_val_run_eval\n",
    "    .groupby(\"query_id\", group_keys=False)\n",
    "    .apply(normalize_per_query)\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "bm25_topk_full = (\n",
    "    bm25_val_candidates\n",
    "    .sort_values([\"query_id\", \"rank\"], ascending=[True, True])\n",
    "    .groupby(\"query_id\", group_keys=False)\n",
    "    .head(candidate_size_full)\n",
    "    .copy()\n",
    ")\n",
    "\n",
    "bm25_topk_full[\"query_id\"] = bm25_topk_full[\"query_id\"].astype(str)\n",
    "bm25_topk_full[\"doc_id\"] = bm25_topk_full[\"doc_id\"].astype(str)\n",
    "\n",
    "bm25_norm = (\n",
    "    bm25_topk_full\n",
    "    .groupby(\"query_id\", group_keys=False)\n",
    "    .apply(normalize_per_query)\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "\n",
    "\n",
    "bge_rr_hybrid_runs = []\n",
    "bge_rr_hybrid_run_dict = {}\n",
    "\n",
    "for l in lambda_values:\n",
    "\n",
    "    merged = pd.merge(\n",
    "        bm25_norm[[\"query_id\", \"doc_id\", \"norm_score\"]],\n",
    "        cross_norm[[\"query_id\", \"doc_id\", \"norm_score\"]],\n",
    "        on=[\"query_id\", \"doc_id\"],\n",
    "        how=\"outer\",\n",
    "        suffixes=(\"_bm25\", \"_cross\")\n",
    "    )\n",
    "\n",
    "    merged[\"norm_score_bm25\"] = merged[\"norm_score_bm25\"].fillna(0)\n",
    "    merged[\"norm_score_cross\"] = merged[\"norm_score_cross\"].fillna(0)\n",
    "\n",
    "    merged[\"score\"] = (\n",
    "        (1 - l) * merged[\"norm_score_bm25\"]\n",
    "        + l * merged[\"norm_score_cross\"]\n",
    "    )\n",
    "\n",
    "    eval_df = (\n",
    "        merged[[\"query_id\", \"doc_id\", \"score\"]]\n",
    "        .sort_values([\"query_id\", \"score\"], ascending=[True, False])\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "    eval_df[\"rank\"] = eval_df.groupby(\"query_id\").cumcount() + 1\n",
    "    eval_df = eval_df[[\"query_id\", \"doc_id\", \"score\", \"rank\"]]\n",
    "\n",
    "    res = ir_measures.calc_aggregate(\n",
    "        metrics,\n",
    "        val_qrels_eval,\n",
    "        eval_df\n",
    "    )\n",
    "\n",
    "    row = {\n",
    "        \"stage\": \"full_lambda_tuning\",\n",
    "        \"model\": \"BGE-Reranker-v2-m3\",\n",
    "        \"candidate_size\": candidate_size_full,\n",
    "        \"selected_instruction\": best_instruction_name,\n",
    "        \"selected_max_length\": best_max_length,\n",
    "        \"doc_max_chars\": doc_max_chars,\n",
    "        \"lambda\": float(l),\n",
    "\n",
    "        \"nDCG@10\": res[nDCG@10],\n",
    "        \"nDCG@100\": res[nDCG@100],\n",
    "        \"nDCG@1000\": res[nDCG@1000],\n",
    "        \"RR@10\": res[RR@10],\n",
    "        \"Recall@10\": res[Recall@10],\n",
    "        \"Recall@100\": res[Recall@100],\n",
    "        \"Recall@500\": res[Recall@500]\n",
    "    }\n",
    "\n",
    "    run = wandb.init(\n",
    "        project=\"trec-tot-hybrid-final\",\n",
    "        name=f\"BGE_RR_{best_instruction_name}_Lambda_{l:.1f}_MaxLen_{best_max_length}_5k\",\n",
    "        config=row,\n",
    "        reinit=True\n",
    "    )\n",
    "\n",
    "    wandb.log(row)\n",
    "    run.finish()\n",
    "\n",
    "    bge_rr_hybrid_runs.append(row)\n",
    "    bge_rr_hybrid_run_dict[float(l)] = eval_df.copy()\n",
    "\n",
    "\n",
    "bge_rr_wb_df = pd.DataFrame(bge_rr_hybrid_runs)\n",
    "\n",
    "display(\n",
    "    bge_rr_wb_df.sort_values(\"nDCG@10\", ascending=False)\n",
    ")\n",
    "\n",
    "best_idx = bge_rr_wb_df[\"nDCG@10\"].idxmax()\n",
    "\n",
    "bge_rr_best_l = float(bge_rr_wb_df.loc[best_idx, \"lambda\"])\n",
    "bge_rr_best_score = float(bge_rr_wb_df.loc[best_idx, \"nDCG@10\"])\n",
    "\n",
    "bge_rr_hybrid_best_run = bge_rr_hybrid_run_dict[bge_rr_best_l].copy()\n",
    "\n",
    "print(\"\\nBGE-RERANKER BEST CONFIGURATION\")\n",
    "print(f\"Selected instruction: {best_instruction_name}\")\n",
    "print(f\"Selected max_length: {best_max_length}\")\n",
    "print(f\"Best lambda: {bge_rr_best_l}\")\n",
    "print(f\"Best nDCG@10: {bge_rr_best_score}\")\n",
    "\n",
    "# BGE-Reranker’s best parameters were identified as: ToT instructions, max_length = 256, and λ = 0.5 (nDCG@10 = 0.1207).\n",
    "# It can thus be deduced that hybrid search was more effective than both BM25 search alone and rerank-only techniques.\n"
   ]
  },
