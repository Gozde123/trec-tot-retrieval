   "source": [
    "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
    "\n",
    "UMAP_SAMPLE_QUERIES = 20\n",
    "TOP_DOCS_PER_QUERY = 5\n",
    "\n",
    "model_for_umap = bge_model\n",
    "model_name_for_umap = \"BGE-M3\"\n",
    "\n",
    "\n",
    "sample_queries = val_queries_pt.head(UMAP_SAMPLE_QUERIES).copy()\n",
    "sample_query_ids = sample_queries[\"qid\"].astype(str).tolist()\n",
    "\n",
    "\n",
    "umap_rows = []\n",
    "texts_to_embed = []\n",
    "\n",
    "for _, qrow in sample_queries.iterrows():\n",
    "\n",
    "    qid = str(qrow[\"qid\"])\n",
    "    query_text = str(qrow[\"query\"])\n",
    "\n",
    "    # Add query\n",
    "    umap_rows.append({\n",
    "        \"query_id\": qid,\n",
    "        \"doc_id\": None,\n",
    "        \"type\": \"query\",\n",
    "        \"text\": query_text\n",
    "    })\n",
    "    texts_to_embed.append(query_text)\n",
    "\n",
    "    # Take top documents from best hybrid run\n",
    "    docs = (\n",
    "        sbert_hybrid_best_run[\n",
    "            sbert_hybrid_best_run[\"query_id\"].astype(str) == qid\n",
    "        ]\n",
    "        .sort_values(\"rank\")\n",
    "        .head(TOP_DOCS_PER_QUERY)\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "    for _, drow in docs.iterrows():\n",
    "\n",
    "        doc_id = str(drow[\"doc_id\"])\n",
    "        doc_text = doc_text_map.get(doc_id)\n",
    "\n",
    "        if doc_text is None:\n",
    "            continue\n",
    "\n",
    "        umap_rows.append({\n",
    "            \"query_id\": qid,\n",
    "            \"doc_id\": doc_id,\n",
    "            \"type\": \"retrieved_doc\",\n",
    "            \"text\": str(doc_text)[:1000]\n",
    "        })\n",
    "\n",
    "        texts_to_embed.append(str(doc_text)[:1000])\n",
    "\n",
    "umap_df = pd.DataFrame(umap_rows)\n",
    "\n",
    "print(\"Total texts for UMAP:\", len(texts_to_embed))\n",
    "display(umap_df.head())\n",
    "\n",
    "\n",
    "with torch.no_grad():\n",
    "    embeddings = model_for_umap.encode(\n",
    "        texts_to_embed,\n",
    "        batch_size=64,\n",
    "        convert_to_numpy=True,\n",
    "        normalize_embeddings=True,\n",
    "        show_progress_bar=True\n",
    "    )\n",
    "\n",
    "\n",
    "# UMAP projection\n",
    "\n",
    "reducer = umap.UMAP(\n",
    "    n_neighbors=10,\n",
    "    min_dist=0.1,\n",
    "    metric=\"cosine\",\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "umap_coords = reducer.fit_transform(embeddings)\n",
    "\n",
    "umap_df[\"umap_x\"] = umap_coords[:, 0]\n",
    "umap_df[\"umap_y\"] = umap_coords[:, 1]\n",
    "\n",
    "plt.figure(figsize=(10, 7))\n",
    "\n",
    "query_points = umap_df[umap_df[\"type\"] == \"query\"]\n",
    "doc_points = umap_df[umap_df[\"type\"] == \"retrieved_doc\"]\n",
    "\n",
    "plt.scatter(\n",
    "    doc_points[\"umap_x\"],\n",
    "    doc_points[\"umap_y\"],\n",
    "    alpha=0.6,\n",
    "    label=\"Retrieved Documents\"\n",
    ")\n",
    "\n",
    "plt.scatter(\n",
    "    query_points[\"umap_x\"],\n",
    "    query_points[\"umap_y\"],\n",
    "    marker=\"X\",\n",
    "    s=120,\n",
    "    label=\"Queries\"\n",
    ")\n",
    "\n",
    "plt.title(f\"UMAP Visualization of {model_name_for_umap} Query and Retrieved Document Embeddings\")\n",
    "plt.xlabel(\"UMAP Dimension 1\")\n",
    "plt.ylabel(\"UMAP Dimension 2\")\n",
    "plt.legend()\n",
    "plt.grid(True)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "\n",
    "plt.figure(figsize=(10, 7))\n",
    "\n",
    "plt.scatter(\n",
    "    doc_points[\"umap_x\"],\n",
    "    doc_points[\"umap_y\"],\n",
    "    alpha=0.6,\n",
    "    label=\"Retrieved Documents\"\n",
    ")\n",
    "\n",
    "plt.scatter(\n",
    "    query_points[\"umap_x\"],\n",
    "    query_points[\"umap_y\"],\n",
    "    marker=\"X\",\n",
    "    s=120,\n",
    "    label=\"Queries\"\n",
    ")\n",
    "\n",
    "plt.title(f\"UMAP Visualization of {model_name_for_umap} Query and Retrieved Document Embeddings\")\n",
    "plt.xlabel(\"UMAP Dimension 1\")\n",
    "plt.ylabel(\"UMAP Dimension 2\")\n",
    "plt.legend()\n",
    "plt.grid(True)\n",
    "plt.tight_layout()\n",
    "\n",
    "plt.savefig(\"umap_interpretability_sbert.png\", dpi=300, bbox_inches=\"tight\")\n",
    "plt.show()\n",
    "\n",
    "print(\"Saved: umap_interpretability_bge.png\")\n",
    "\n",
    "# The UMAP projection shows that queries form a relatively compact cluster, while retrieved documents are distributed across a wider semantic space.\n",
    "# The visualization provides a qualitative view of the embedding distribution, although no strong conclusions should be drawn from the 2D projection alone.\n"
   ]
  },
