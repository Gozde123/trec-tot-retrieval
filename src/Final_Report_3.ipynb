    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "MonoT5 BEST CONFIGURATION\n",
      "Selected instruction: semantic\n",
      "Selected max_length: 384\n",
      "Base lambda=1.0 nDCG@10: 0.010419263352045975\n",
      "Best lambda: 0.1\n",
      "Best nDCG@10: 0.08198043845546617\n"
     ]
