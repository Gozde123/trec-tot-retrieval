    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "SBERT BEST CONFIGURATION\n",
      "Selected max_seq_length: 256\n",
      "Best lambda: 0.7000000000000001\n",
      "Best nDCG@10: 0.14994023114167804\n"
     ]
    }
   ],
   "source": [
    "torch.cuda.empty_cache()\n",
    "gc.collect()\n",
    "\n",
    "device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
    "print(\"Device:\", device)\n",
    "\n",
    "# Correct SBERT loading\n",
    "sbert_model = SentenceTransformer(\n",
    "    \"sentence-transformers/all-mpnet-base-v2\",\n",
    "    device=device\n",
    ")\n",
    "\n",
    "metrics = [\n",
    "    nDCG@10, nDCG@100, nDCG@1000,\n",
    "    RR@10,\n",
    "    Recall@10, Recall@100, Recall@500\n",
    "]\n",
    "\n",
    "candidate_size_full = 5000\n",
    "candidate_size_probe = 500\n",
    "batch_size = 128 if device == \"cuda\" else 32\n",
    "\n",
    "max_seq_lengths = [256, 384, 512]\n",
    "lambda_values = np.arange(0.0, 1.01, 0.1)\n",
    "\n",
    "probe_queries = val_queries_pt.head(40).copy()\n",
    "\n",
    "\n",
    "def normalize_per_query(df):\n",
    "    df = df.copy()\n",
    "    mn = df[\"score\"].min()\n",
    "    mx = df[\"score\"].max()\n",
    "\n",
    "    if mn == mx:\n",
    "        df[\"norm_score\"] = 0.0\n",
    "    else:\n",
    "        df[\"norm_score\"] = (df[\"score\"] - mn) / (mx - mn)\n",
    "\n",
    "    return df\n",
    "\n",
    "\n",
    "def build_dense_run(model, queries_df, bm25_df, candidate_size):\n",
    "    bm25_topk = (\n",
    "        bm25_df\n",
    "        .sort_values([\"query_id\", \"rank\"], ascending=[True, True])\n",
    "        .groupby(\"query_id\", group_keys=False)\n",
    "        .head(candidate_size)\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "    bm25_topk[\"query_id\"] = bm25_topk[\"query_id\"].astype(str)\n",
    "    bm25_topk[\"doc_id\"] = bm25_topk[\"doc_id\"].astype(str)\n",
    "\n",
    "    query_ids = set(queries_df[\"qid\"].astype(str))\n",
    "    bm25_topk = bm25_topk[bm25_topk[\"query_id\"].isin(query_ids)].copy()\n",
    "\n",
    "    unique_doc_ids = bm25_topk[\"doc_id\"].unique().tolist()\n",
    "\n",
    "    doc_ids_with_text = []\n",
    "    doc_texts = []\n",
    "\n",
    "    for doc_id in unique_doc_ids:\n",
    "        text = doc_text_map.get(doc_id)\n",
    "\n",
    "        if text is not None and str(text).strip() != \"\":\n",
    "            doc_ids_with_text.append(doc_id)\n",
    "            doc_texts.append(str(text))\n",
    "\n",
    "    print(\"Documents to encode:\", len(doc_texts))\n",
    "\n",
    "    if len(doc_texts) == 0:\n",
    "        return pd.DataFrame(columns=[\"query_id\", \"doc_id\", \"score\", \"rank\"])\n",
    "\n",
    "    with torch.no_grad():\n",
    "        doc_embs = model.encode(\n",
    "            doc_texts,\n",
    "            batch_size=batch_size,\n",
    "            show_progress_bar=True,\n",
    "            convert_to_numpy=True,\n",
    "            normalize_embeddings=True\n",
    "        )\n",
    "\n",
    "    doc_id_to_idx = {\n",
    "        doc_id: idx\n",
    "        for idx, doc_id in enumerate(doc_ids_with_text)\n",
    "    }\n",
    "\n",
    "    run_rows = []\n",
    "\n",
    "    for i, (_, qrow) in enumerate(queries_df.iterrows(), start=1):\n",
    "        qid = str(qrow[\"qid\"])\n",
    "        query_text = str(qrow[\"query\"])\n",
    "\n",
    "        cand_docs = bm25_topk[bm25_topk[\"query_id\"] == qid].copy()\n",
    "        cand_docs = cand_docs[cand_docs[\"doc_id\"].isin(doc_id_to_idx)].copy()\n",
    "\n",
    "        if len(cand_docs) == 0:\n",
    "            continue\n",
    "\n",
    "        with torch.no_grad():\n",
    "            query_emb = model.encode(\n",
    "                [query_text],\n",
    "                convert_to_numpy=True,\n",
    "                normalize_embeddings=True\n",
    "            )[0]\n",
    "\n",
    "        idxs = cand_docs[\"doc_id\"].map(doc_id_to_idx).values\n",
    "        scores = np.dot(doc_embs[idxs], query_emb)\n",
    "\n",
    "        cand_docs[\"score\"] = scores\n",
    "        cand_docs = cand_docs.sort_values(\"score\", ascending=False).reset_index(drop=True)\n",
    "        cand_docs[\"rank\"] = np.arange(1, len(cand_docs) + 1)\n",
    "\n",
    "        run_rows.extend(\n",
    "            cand_docs[[\"query_id\", \"doc_id\", \"score\", \"rank\"]].to_dict(\"records\")\n",
    "        )\n",
    "\n",
    "        if i % 5 == 0:\n",
    "            print(f\"Query {i}/{len(queries_df)} finished\")\n",
    "\n",
    "    dense_run = pd.DataFrame(run_rows)\n",
    "\n",
    "    del doc_embs\n",
    "    torch.cuda.empty_cache()\n",
    "    gc.collect()\n",
    "\n",
    "    return dense_run\n",
    "\n",
    "\n",
    "\n",
    "probe_results = []\n",
    "\n",
    "for max_len in max_seq_lengths:\n",
    "    print(f\"\\nPROBE: SBERT max_seq_length={max_len}\")\n",
    "\n",
    "    sbert_model.max_seq_length = max_len\n",
    "\n",
    "    dense_probe = build_dense_run(\n",
    "        model=sbert_model,\n",
    "        queries_df=probe_queries,\n",
    "        bm25_df=bm25_val_candidates,\n",
    "        candidate_size=candidate_size_probe\n",
    "    )\n",
    "\n",
    "    if dense_probe.empty:\n",
    "        print(\"Dense probe is empty. Skipping.\")\n",
    "        continue\n",
    "\n",
    "    res = ir_measures.calc_aggregate(\n",
    "        [nDCG@10, RR@10, Recall@10],\n",
    "        val_qrels_eval,\n",
    "        dense_probe\n",
    "    )\n",
    "\n",
    "    row = {\n",
    "        \"stage\": \"max_seq_length_probe\",\n",
    "        \"model\": \"SBERT\",\n",
    "        \"candidate_size\": candidate_size_probe,\n",
    "        \"num_probe_queries\": len(probe_queries),\n",
    "        \"max_seq_length\": max_len,\n",
    "        \"lambda\": 1.0,\n",
    "        \"nDCG@10\": res[nDCG@10],\n",
    "        \"RR@10\": res[RR@10],\n",
    "        \"Recall@10\": res[Recall@10]\n",
    "    }\n",
    "\n",
    "    run = wandb.init(\n",
    "        project=\"trec-tot-hybrid-final\",\n",
    "        name=f\"SBERT_MaxLenProbe_{max_len}_500cand_40q\",\n",
    "        config=row,\n",
    "        reinit=True\n",
    "    )\n",
    "\n",
    "    wandb.log(row)\n",
    "    run.finish()\n",
    "\n",
    "    probe_results.append(row)\n",
    "\n",
    "\n",
    "probe_df = pd.DataFrame(probe_results)\n",
    "\n",
    "display(probe_df.sort_values(\"nDCG@10\", ascending=False))\n",
    "\n",
    "best_max_len = int(\n",
    "    probe_df.sort_values(\"nDCG@10\", ascending=False).iloc[0][\"max_seq_length\"]\n",
    ")\n",
    "\n",
    "print(\"\\nSelected max_seq_length:\", best_max_len)\n",
    "\n",
    "\n",
    "print(f\"\\nFULL RUN: SBERT max_seq_length={best_max_len}, candidate_size={candidate_size_full}\")\n",
    "\n",
    "sbert_model.max_seq_length = best_max_len\n",
    "\n",
    "bm25_topk_full = (\n",
    "    bm25_val_candidates\n",
    "    .sort_values([\"query_id\", \"rank\"], ascending=[True, True])\n",
    "    .groupby(\"query_id\", group_keys=False)\n",
    "    .head(candidate_size_full)\n",
    "    .copy()\n",
    ")\n",
    "\n",
    "bm25_topk_full[\"query_id\"] = bm25_topk_full[\"query_id\"].astype(str)\n",
    "bm25_topk_full[\"doc_id\"] = bm25_topk_full[\"doc_id\"].astype(str)\n",
    "\n",
    "bm25_norm = (\n",
    "    bm25_topk_full\n",
    "    .groupby(\"query_id\", group_keys=False)\n",
    "    .apply(normalize_per_query)\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "sbert_val_run_eval = build_dense_run(\n",
    "    model=sbert_model,\n",
    "    queries_df=val_queries_pt,\n",
    "    bm25_df=bm25_val_candidates,\n",
    "    candidate_size=candidate_size_full\n",
    ")\n",
    "\n",
    "sbert_norm = (\n",
    "    sbert_val_run_eval\n",
    "    .groupby(\"query_id\", group_keys=False)\n",
    "    .apply(normalize_per_query)\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "\n",
    "\n",
    "sbert_hybrid_runs = []\n",
    "sbert_hybrid_run_dict = {}\n",
    "\n",
    "for l in lambda_values:\n",
    "    print(f\"\\nLambda: {l:.1f}\")\n",
    "\n",
    "    merged = pd.merge(\n",
    "        bm25_norm[[\"query_id\", \"doc_id\", \"norm_score\"]],\n",
    "        sbert_norm[[\"query_id\", \"doc_id\", \"norm_score\"]],\n",
    "        on=[\"query_id\", \"doc_id\"],\n",
    "        how=\"outer\",\n",
    "        suffixes=(\"_bm25\", \"_sbert\")\n",
    "    )\n",
    "\n",
    "    merged[\"norm_score_bm25\"] = merged[\"norm_score_bm25\"].fillna(0)\n",
    "    merged[\"norm_score_sbert\"] = merged[\"norm_score_sbert\"].fillna(0)\n",
    "\n",
    "    merged[\"score\"] = (\n",
    "        (1 - l) * merged[\"norm_score_bm25\"]\n",
    "        + l * merged[\"norm_score_sbert\"]\n",
    "    )\n",
    "\n",
    "    eval_df = (\n",
    "        merged[[\"query_id\", \"doc_id\", \"score\"]]\n",
    "        .sort_values([\"query_id\", \"score\"], ascending=[True, False])\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "    eval_df[\"rank\"] = eval_df.groupby(\"query_id\").cumcount() + 1\n",
    "    eval_df = eval_df[[\"query_id\", \"doc_id\", \"score\", \"rank\"]]\n",
    "\n",
    "    res = ir_measures.calc_aggregate(\n",
    "        metrics,\n",
    "        val_qrels_eval,\n",
    "        eval_df\n",
    "    )\n",
    "\n",
    "    row = {\n",
    "        \"stage\": \"full_lambda_tuning\",\n",
    "        \"model\": \"SBERT\",\n",
    "        \"candidate_size\": candidate_size_full,\n",
    "        \"selected_max_seq_length\": best_max_len,\n",
    "        \"lambda\": float(l),\n",
    "        \"nDCG@10\": res[nDCG@10],\n",
    "        \"nDCG@100\": res[nDCG@100],\n",
    "        \"nDCG@1000\": res[nDCG@1000],\n",
    "        \"RR@10\": res[RR@10],\n",
    "        \"Recall@10\": res[Recall@10],\n",
    "        \"Recall@100\": res[Recall@100],\n",
    "        \"Recall@500\": res[Recall@500]\n",
    "    }\n",
    "\n",
    "    run = wandb.init(\n",
    "        project=\"trec-tot-hybrid-final\",\n",
    "        name=f\"SBERT_Lambda_{l:.1f}_MaxLen_{best_max_len}_5k\",\n",
    "        config=row,\n",
    "        reinit=True\n",
    "    )\n",
    "\n",
    "    wandb.log(row)\n",
    "    run.finish()\n",
    "\n",
    "    sbert_hybrid_runs.append(row)\n",
    "    sbert_hybrid_run_dict[float(l)] = eval_df.copy()\n",
    "\n",
    "\n",
    "sbert_wb_df = pd.DataFrame(sbert_hybrid_runs)\n",
    "\n",
    "display(\n",
    "    sbert_wb_df.sort_values(\"nDCG@10\", ascending=False)\n",
    ")\n",
    "\n",
    "best_idx = sbert_wb_df[\"nDCG@10\"].idxmax()\n",
    "best_lambda = float(sbert_wb_df.loc[best_idx, \"lambda\"])\n",
    "best_ndcg = float(sbert_wb_df.loc[best_idx, \"nDCG@10\"])\n",
    "\n",
    "sbert_hybrid_best_run = sbert_hybrid_run_dict[best_lambda].copy()\n",
    "\n",
    "print(\"\\nSBERT BEST CONFIGURATION\")\n",
    "print(f\"Selected max_seq_length: {best_max_len}\")\n",
    "print(f\"Best lambda: {best_lambda}\")\n",
    "print(f\"Best nDCG@10: {best_ndcg}\")\n",
    "\n",
    "# From the various combinations analyzed, it is evident that those whose parameters had values of max_seq_length=256 and λ=0.7\n",
    "# gave the best metrics (nDCG@10=0.1499). This shows that the effectiveness of hybrid retrieval models is confirmed when processing vague ToT questions."
   ]
  },
