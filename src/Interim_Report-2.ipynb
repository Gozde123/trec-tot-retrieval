      "source": [
        "torch.cuda.empty_cache()\n",
        "gc.collect()\n",
        "\n",
        "model_name = \"BAAI/bge-reranker-v2-m3\"\n",
        "tokenizer = AutoTokenizer.from_pretrained(model_name)\n",
        "model = AutoModelForSequenceClassification.from_pretrained(\n",
        "    model_name,\n",
        "    torch_dtype=torch.float16\n",
        ").to(\"cuda\").eval()\n",
        "\n",
        "cross_run_rows = []\n",
        "TOP_K_RERANK = 10000\n",
        "BATCH_SIZE = 512\n",
        "\n",
        "print(f\"Starting Cross-Encoder Reranking with {model_name}...\")\n",
        "\n",
        "for i, (_, qrow) in enumerate(val_queries_pt.iterrows(), start=1):\n",
        "    qid = str(qrow[\"qid\"])\n",
        "    query_text = str(qrow[\"query\"])\n",
        "\n",
        "    cand_docs = bm25_val_candidates[bm25_val_candidates[\"query_id\"] == qid].head(TOP_K_RERANK).copy()\n",
        "    cand_docs[\"text\"] = cand_docs[\"doc_id\"].map(doc_text_map)\n",
        "    cand_docs = cand_docs.dropna(subset=[\"text\"])\n",
        "\n",
        "    if len(cand_docs) == 0: continue\n",
        "\n",
        "\n",
        "    texts = cand_docs[\"text\"].tolist()\n",
        "    pairs = [[query_text, t[:1500]] for t in texts]\n",
        "\n",
        "    all_scores = []\n",
        "\n",
        "    for j in range(0, len(pairs), BATCH_SIZE):\n",
        "        batch_pairs = pairs[j : j + BATCH_SIZE]\n",
        "\n",
        "        inputs = tokenizer(\n",
        "            batch_pairs,\n",
        "            padding=True,\n",
        "            truncation=True,\n",
        "            return_tensors='pt',\n",
        "            max_length=512\n",
        "        ).to(\"cuda\")\n",
        "\n",
        "        with torch.no_grad():\n",
        "            # logit score modification: Cross-encoder\n",
        "            logits = model(**inputs).logits.view(-1).float()\n",
        "            all_scores.extend(logits.cpu().numpy())\n",
        "\n",
        "        del inputs, logits\n",
        "\n",
        "    cand_docs[\"score\"] = all_scores\n",
        "    cand_docs = cand_docs.sort_values(\"score\", ascending=False).reset_index(drop=True)\n",
        "    cand_docs[\"rank\"] = np.arange(1, len(cand_docs) + 1)\n",
        "\n",
        "\n",
        "    for _, row in cand_docs.iterrows():\n",
        "        cross_run_rows.append({\n",
        "            \"query_id\": qid,\n",
        "            \"doc_id\": str(row[\"doc_id\"]),\n",
        "            \"score\": float(row[\"score\"]),\n",
        "            \"rank\": int(row[\"rank\"])\n",
        "        })\n",
        "\n",
        "    if i % 5 == 0:\n",
        "        print(f\"Processed {i}/{len(val_queries_pt)} queries (Cross-Encoder)\")\n",
        "        torch.cuda.empty_cache()\n",
        "\n",
        "cross_val_run_eval = pd.DataFrame(cross_run_rows)\n",
        "print(\"Cross-Encoder Reranking Finished!\")"
      ]
