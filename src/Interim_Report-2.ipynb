      "source": [
        "# required imports\n",
        "## BM25 Candidate-Size Ablation\n",
        "\n",
        "# In this section, we evaluate the effect of BM25 candidate set size on retrieval coverage\n",
        "# and ranking metrics. The full corpus is used through the PyTerrier index,\n",
        "# and BM25 retrieval model used.\n",
        "# for candidate size generally it was taken as 1000. Still we want to make our experiment.\n",
        "\n",
        "# validation queries format\n",
        "val_queries_pt = val_queries_df.copy()\n",
        "val_queries_pt[\"qid\"] = val_queries_pt[\"query_id\"].astype(str)\n",
        "val_queries_pt[\"query\"] = val_queries_pt[\"query\"].astype(str)\n",
        "val_queries_pt = val_queries_pt[[\"qid\", \"query\"]]\n",
        "\n",
        "# validation qrels format\n",
        "val_qrels_eval = val_qrels_df.copy()\n",
        "val_qrels_eval[\"query_id\"] = val_qrels_eval[\"query_id\"].astype(str)\n",
        "val_qrels_eval[\"doc_id\"] = val_qrels_eval[\"doc_id\"].astype(str)\n",
        "\n",
        "\n",
        "candidate_sizes = [50, 100, 200, 500, 1000, 2000, 5000,10000,20000]\n",
        "\n",
        "bm25_candidate_results = []\n",
        "\n",
        "for cand_size in candidate_sizes:\n",
        "    print(f\"Running BM25 with candidate size = {cand_size} ...\")\n",
        "\n",
        "    start_time = time.time()\n",
        "\n",
        "    bm25 = pt.BatchRetrieve(\n",
        "        index,\n",
        "        wmodel=\"BM25\",\n",
        "        num_results=cand_size,\n",
        "        controls={\"bm25.k_1\": 0.9, \"bm25.b\": 0.9}\n",
        "    )\n",
        "\n",
        "    bm25_val_run = bm25.transform(val_queries_pt)\n",
        "\n",
        "    runtime_sec = time.time() - start_time\n",
        "\n",
        "    # rename for evaluation\n",
        "    bm25_val_run_eval = bm25_val_run.rename(columns={\n",
        "        \"qid\": \"query_id\",\n",
        "        \"docno\": \"doc_id\"\n",
        "    })[[\"query_id\", \"doc_id\", \"score\", \"rank\"]].copy()\n",
        "\n",
        "    bm25_val_run_eval[\"query_id\"] = bm25_val_run_eval[\"query_id\"].astype(str)\n",
        "    bm25_val_run_eval[\"doc_id\"] = bm25_val_run_eval[\"doc_id\"].astype(str)\n",
        "\n",
        "    # make rank 1-based for safety\n",
        "    bm25_val_run_eval[\"rank\"] = bm25_val_run_eval[\"rank\"].astype(int) + 1\n",
        "\n",
        "    # candidate coverage\n",
        "    candidate_recall = ir_measures.calc_aggregate(\n",
        "        [Recall@cand_size],\n",
        "        val_qrels_eval,\n",
        "        bm25_val_run_eval\n",
        "    )[Recall@cand_size]\n",
        "\n",
        "    # ranking metrics\n",
        "    ranking_results = ir_measures.calc_aggregate(\n",
        "        [Recall@10, RR@10, nDCG@10,nDCG@100,nDCG@1000],\n",
        "        val_qrels_eval,\n",
        "        bm25_val_run_eval\n",
        "    )\n",
        "\n",
        "    bm25_candidate_results.append({\n",
        "        \"candidate_size\": cand_size,\n",
        "        \"candidate_recall\": candidate_recall,\n",
        "        \"Recall@10\": ranking_results[Recall@10],\n",
        "        \"MRR@10\": ranking_results[RR@10],\n",
        "        \"nDCG@10\": ranking_results[nDCG@10],\n",
        "        \"nDCG@100\": ranking_results[nDCG@100],\n",
        "        \"nDCG@1000\": ranking_results[nDCG@1000],\n",
        "        \"runtime_sec\": runtime_sec\n",
        "    })\n",
        "\n",
        "bm25_candidate_results_df = pd.DataFrame(bm25_candidate_results)\n",
        "\n",
        "display(bm25_candidate_results_df)"
      ]
    },
