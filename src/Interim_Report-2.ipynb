        "metrics_final = [\n",
        "    nDCG@10, nDCG@100, nDCG@1000,\n",
        "    Recall@10, Recall@100, Recall@500, Recall@1000\n",
        "]\n",
        "\n",
        "def get_model_final_metrics(qrels, run_df, model_name):\n",
        "    res = ir_measures.calc_aggregate(metrics_final, qrels, run_df)\n",
        "    return {\n",
        "        \"Model\": model_name,\n",
        "        \"nDCG@10\": res.get(nDCG@10, 0),\n",
        "        \"nDCG@100\": res.get(nDCG@100, 0),\n",
        "        \"nDCG@1000\": res.get(nDCG@1000, 0),\n",
        "        \"Recall@10\": res.get(Recall@10, 0),\n",
        "        \"Recall@100\": res.get(Recall@100, 0),\n",
        "        \"Recall@500\": res.get(Recall@500, 0),\n",
        "        \"Recall@1000\": res.get(Recall@1000, 0)\n",
        "    }\n",
        "\n",
        "\n",
        "final_results_list = []\n",
        "\n",
        "final_results_list.append(get_model_final_metrics(val_qrels_eval, bm25_val_candidates, \"BM25 (Baseline)\"))\n",
        "\n",
        "final_results_list.append(get_model_final_metrics(val_qrels_eval, sbert_hybrid_best, \"Hybrid SBERT\"))\n",
        "final_results_list.append(get_model_final_metrics(val_qrels_eval, bge_hybrid_best, \"Hybrid BGE-M3\"))\n",
        "final_results_list.append(get_model_final_metrics(val_qrels_eval, reranker_hybrid_best, \"Hybrid Reranker (BGE-RR)\"))\n",
        "final_results_list.append(get_model_final_metrics(val_qrels_eval, monot5_hybrid_best, \"Hybrid MonoT5\"))\n",
        "\n",
        "\n",
        "master_results_df = pd.DataFrame(final_results_list)\n",
        "\n",
        "master_results_df = master_results_df.sort_values(\"nDCG@10\", ascending=False).reset_index(drop=True)\n",
