   "source": [
    "candidate_size_final = 5000\n",
    "\n",
    "candidate_recall_perq = []\n",
    "\n",
    "for qid in val_queries_pt[\"qid\"].astype(str):\n",
    "    qrels_q = val_qrels_eval[val_qrels_eval[\"query_id\"].astype(str) == qid]\n",
    "    retrieved_q = bm25_val_run_eval[bm25_val_run_eval[\"query_id\"].astype(str) == qid]\n",
    "\n",
    "    relevant_docs = set(qrels_q[qrels_q[\"relevance\"] > 0][\"doc_id\"].astype(str))\n",
    "    retrieved_docs = set(retrieved_q[\"doc_id\"].astype(str).head(candidate_size_final))\n",
    "\n",
    "    if len(relevant_docs) == 0:\n",
    "        covered = np.nan\n",
    "    else:\n",
    "        covered = len(relevant_docs.intersection(retrieved_docs)) / len(relevant_docs)\n",
    "\n",
    "    candidate_recall_perq.append({\n",
    "        \"query_id\": qid,\n",
    "        \"candidate_recall\": covered\n",
    "    })\n",
    "\n",
    "candidate_recall_perq_df = pd.DataFrame(candidate_recall_perq)\n",
    "\n",
    "ceiling_error_df = error_df.merge(\n",
    "    candidate_recall_perq_df,\n",
    "    on=\"query_id\",\n",
    "    how=\"left\"\n",
    ")\n",
    "\n",
    "print(\"Failure cases where candidate recall is zero:\")\n",
    "display(\n",
    "    ceiling_error_df[\n",
    "        (ceiling_error_df[\"hybrid_ndcg10\"] == 0) &\n",
    "        (ceiling_error_df[\"candidate_recall\"] == 0)\n",
    "    ].head(10)\n",
    ")\n",
    "\n",
    "# In some cases, the candidate recall value was zero, which implied that the concerned document had not been selected by the BM25 model.\n",
    "# Consequently, no success could be obtained from either the hybrid model or the reranking approach. This was a drawback of the candidate generation phase."
   ]
