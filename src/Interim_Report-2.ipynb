      "source": [
        "# creating index\n",
        "index_path = \"./tot_index\"\n",
        "data_properties = os.path.join(index_path, \"data.properties\")\n",
        "\n",
        "\n",
        "FORCE_REBUILD_INDEX = False\n",
        "\n",
        "if FORCE_REBUILD_INDEX and os.path.exists(index_path):\n",
        "    shutil.rmtree(index_path)\n",
        "    print(\"Old/corrupted index deleted.\")\n",
        "\n",
        "# Corpus generator\n",
        "def corpus_generator():\n",
        "    for doc in corpus_2024.docs_iter():\n",
        "        text = ((doc.title or \"\") + \" \" + (doc.text or \"\")).strip()\n",
        "\n",
        "        if text:\n",
        "            yield {\n",
        "                \"docno\": str(doc.doc_id),\n",
        "                \"text\": text\n",
        "            }\n",
        "\n",
        "if os.path.exists(data_properties):\n",
        "    print(\"Existing index found locally. Loading.\")\n",
        "    index_ref = pt.IndexRef.of(data_properties)\n",
        "else:\n",
        "    print(\"Building index and saving locally.\")\n",
        "    os.makedirs(index_path, exist_ok=True)\n",
        "\n",
        "    indexer = pt.IterDictIndexer(\n",
        "        index_path,\n",
        "        overwrite=True,\n",
        "        meta={\n",
        "            \"docno\": 50\n",
        "        }\n",
        "    )\n",
        "\n",
        "    index_ref = indexer.index(corpus_generator())\n",
        "\n",
        "# Index checking\n",
        "index = pt.IndexFactory.of(index_ref)\n",
        "\n",
        "print(\"Index ready.\")\n",
        "print(index.getCollectionStatistics())"
      ]
    },
