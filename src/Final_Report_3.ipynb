    "# Query document examples\n",
    "def show_top_docs_for_query(query_id, run_df, model_name, top_n=5):\n",
    "    query_id = str(query_id)\n",
    "\n",
    "    query_text = val_queries_pt[\n",
    "        val_queries_pt[\"qid\"].astype(str) == query_id\n",
    "    ][\"query\"].iloc[0]\n",
    "\n",
    "    docs = (\n",
    "        run_df[run_df[\"query_id\"].astype(str) == query_id]\n",
    "        .sort_values(\"rank\")\n",
    "        .head(top_n)\n",
    "        .copy()\n",
    "    )\n",
    "\n",
    "    docs[\"doc_text\"] = docs[\"doc_id\"].map(doc_text_map)\n",
    "    docs[\"doc_preview\"] = docs[\"doc_text\"].astype(str).str.slice(0, 300)\n",
    "\n",
    "    print(\"\\nMODEL:\", model_name)\n",
    "    print(\"QUERY ID:\", query_id)\n",
    "    print(\"QUERY:\", query_text)\n",
    "\n",
    "    display(docs[[\"rank\", \"doc_id\", \"score\", \"doc_preview\"]])\n",
    "\n",
    "\n",
    "example_failure_qid = str(failure_cases.iloc[0][\"query_id\"])\n",
    "\n",
    "show_top_docs_for_query(example_failure_qid, bm25_val_run_eval, \"BM25\", top_n=5)\n",
    "show_top_docs_for_query(example_failure_qid, sbert_hybrid_best_run, \"Hybrid SBERT\", top_n=5)\n",
    "\n",
    "\n",
    "# In Query 252, for example, there was an instance where the performance of BM25 was better than that of the hybrid.\n",
    "# BM25 managed to rank the right movie (*Sucker Punch*) fourth while the hybrid concentrated on the general concepts of girls and dancing without ranking the movie well."
