        "best_candidate_size = 10000\n",
        "\n",
        "save_dir = \"./tot_outputs\"\n",
        "os.makedirs(save_dir, exist_ok=True)\n",
        "\n",
        "with open(f\"{save_dir}/best_candidate_size.json\", \"w\") as f:\n",
