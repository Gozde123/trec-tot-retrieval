      "source": [
        "bge_wb_df = pd.DataFrame(bge_hybrid_runs)\n",
        "\n",
        "\n",
        "bge_wb_df = bge_wb_df.sort_values(\"nDCG@10\", ascending=False).drop_duplicates(\"lambda\")\n",
        "\n",
        "best_row = bge_wb_df.loc[bge_wb_df[\"nDCG@10\"].idxmax()]\n",
        "bge_best_l = float(best_row[\"lambda\"])\n",
        "bge_best_score = float(best_row[\"nDCG@10\"])\n",
        "\n",
        "base_row = bge_wb_df[bge_wb_df[\"lambda\"] == 1.0].iloc[0]\n",
        "bge_base_score = float(base_row[\"nDCG@10\"])\n",
        "\n",
        "print(f\"Base (1.0) nDCG@10: {bge_base_score:.6f}\")\n",
        "print(f\"Best ({bge_best_l}) nDCG@10: {bge_best_score:.6f}\")\n",
        "\n",
        "\n",
        "bge_hybrid_best_run = bge_hybrid_run_dict[bge_best_l].copy()"
      ]
    },
