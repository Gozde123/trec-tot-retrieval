      "cell_type": "code",
      "source": [
        "def get_per_query_ndcg(qrels, run):\n",
        "    results = list(ir_measures.iter_calc([nDCG@10], qrels, run))\n",
        "    return pd.Series({r.query_id: r.value for r in results})\n",
        "\n",
        "def hybrid_search_simple(bm25_df, model_df, lambda_val):\n",
        "\n",
        "    merged = pd.merge(\n",
        "        bm25_df[[\"query_id\", \"doc_id\", \"norm_score\"]],\n",
        "        model_df[[\"query_id\", \"doc_id\", \"norm_score\"]],\n",
        "        on=[\"query_id\", \"doc_id\"],\n",
        "        suffixes=(\"_bm25\", \"_model\"),\n",
        "        how=\"outer\"\n",
        "    ).fillna(0)\n",
        "    merged[\"score\"] = (1 - lambda_val) * merged[\"norm_score_bm25\"] + lambda_val * merged[\"norm_score_model\"]\n",
        "    merged = merged.sort_values([\"query_id\", \"score\"], ascending=[True, False]).copy()\n",
        "    merged[\"rank\"] = merged.groupby(\"query_id\").cumcount() + 1\n",
        "    return merged[[\"query_id\", \"doc_id\", \"score\", \"rank\"]]\n",
        "\n",
        "def perform_test(name_a, scores_a, name_b, scores_b):\n",
        "    # Paired T-Test\n",
        "    t_stat, p_val = stats.ttest_rel(scores_a, scores_b)\n",
        "    return {\n",
        "        \"Comparison\": f\"{name_a} vs {name_b}\",\n",
        "        \"Mean A\": scores_a.mean(),\n",
        "        \"Mean B\": scores_b.mean(),\n",
        "        \"Diff %\": ((scores_b.mean() - scores_a.mean()) / scores_a.mean()) * 100,\n",
        "        \"p-value\": p_val,\n",
        "        \"Significant\": p_val < 0.05\n",
        "    }\n",
        "\n",
        "\n",
        "bge_hybrid_best = hybrid_search_simple(bm25_norm, bge_norm, lambda_val=0.7)\n",
        "sbert_hybrid_best = hybrid_search_simple(bm25_norm, sbert_norm, lambda_val=0.7)\n",
        "reranker_hybrid_best = hybrid_search_simple(bm25_norm, cross_norm, lambda_val=0.6)\n",
        "monot5_hybrid_best = hybrid_search_simple(bm25_norm, monot5_norm, lambda_val=monot5_best_l) # Senin bulduğun en iyi l\n",
        "\n",
        "bm25_scores = get_per_query_ndcg(val_qrels_eval, bm25_val_candidates)\n",
        "\n",
        "# Base Models\n",
        "sbert_base_scores = get_per_query_ndcg(val_qrels_eval, sbert_val_run_eval)\n",
        "bge_base_scores = get_per_query_ndcg(val_qrels_eval, bge_val_run_eval)\n",
        "reranker_base_scores = get_per_query_ndcg(val_qrels_eval, cross_val_run_eval) # Reranker = Cross-Encoder\n",
        "monot5_base_scores = get_per_query_ndcg(val_qrels_eval, monoT5_val_run_eval)\n",
        "\n",
        "# Hybrid Models\n",
        "sbert_hyb_scores = get_per_query_ndcg(val_qrels_eval, sbert_hybrid_best)\n",
        "bge_hyb_scores = get_per_query_ndcg(val_qrels_eval, bge_hybrid_best)\n",
        "reranker_hyb_scores = get_per_query_ndcg(val_qrels_eval, reranker_hybrid_best)\n",
        "monot5_hyb_scores = get_per_query_ndcg(val_qrels_eval, monot5_hybrid_best)\n",
        "\n",
        "\n",
        "test_results = [\n",
        "\n",
        "    perform_test(\"Base SBERT\", sbert_base_scores, \"Hybrid SBERT\", sbert_hyb_scores),\n",
        "    perform_test(\"Base BGE-M3\", bge_base_scores, \"Hybrid BGE-M3\", bge_hyb_scores),\n",
        "    perform_test(\"Base Reranker\", reranker_base_scores, \"Hybrid Reranker\", reranker_hyb_scores),\n",
        "    perform_test(\"Base MonoT5\", monot5_base_scores, \"Hybrid MonoT5\", monot5_hyb_scores),\n",
        "\n",
        "\n",
        "    perform_test(\"BM25\", bm25_scores, \"Hybrid Reranker\", reranker_hyb_scores),\n",
        "    perform_test(\"BM25\", bm25_scores, \"Hybrid MonoT5\", monot5_hyb_scores),\n",
        "    perform_test(\"BM25\", bm25_scores, \"Hybrid SBERT\", sbert_hyb_scores),\n",
        "    perform_test(\"BM25\", bm25_scores, \"Hybrid BGE-M3\", bge_hyb_scores),\n",
        "\n",
        "    perform_test(\"Hybrid BGE-M3\", bge_hyb_scores, \"Hybrid MonoT5\", monot5_hyb_scores),\n",
        "    perform_test(\"Hybrid Reranker\", reranker_hyb_scores, \"Hybrid MonoT5\", monot5_hyb_scores),\n",
        "    perform_test(\"Hybrid SBERT\", sbert_hyb_scores, \"Hybrid MonoT5\", monot5_hyb_scores),\n",
        "    perform_test(\"Hybrid SBERT\", sbert_hyb_scores, \"Hybrid BGE-M3\", bge_hyb_scores)\n",
        "]\n",
        "\n",
        "significance_report = pd.DataFrame(test_results)\n",
        "print(\"\\n STATISTICAL SIGNIFICANCE REPORT (nDCG@10)\")\n",
        "display(significance_report)"
      ],
