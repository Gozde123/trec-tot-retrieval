   "source": [
    "bm25_perq = per_query_metric(bm25_val_run_eval, nDCG@10, \"bm25_ndcg10\")\n",
    "best_perq = per_query_metric(sbert_hybrid_best_run, nDCG@10, \"best_hybrid_ndcg10\")\n",
    "\n",
    "error_df = bm25_perq.merge(best_perq, on=\"query_id\", how=\"outer\").fillna(0)\n",
    "error_df[\"difference\"] = error_df[\"best_hybrid_ndcg10\"] - error_df[\"bm25_ndcg10\"]\n",
    "\n",
    "error_df = error_df.merge(\n",
    "    val_queries_pt.rename(columns={\"qid\": \"query_id\"}),\n",
    "    on=\"query_id\",\n",
    "    how=\"left\"\n",
    ")\n",
    "\n",
    "print(\"Hybrid improved over BM25:\")\n",
    "improvement_cases = error_df.sort_values(\"difference\", ascending=False).head(10)\n",
    "display(improvement_cases)\n",
    "\n",
    "print(\"Hybrid underperformed BM25:\")\n",
    "failure_cases = error_df.sort_values(\"difference\", ascending=True).head(10)\n",
    "display(failure_cases)\n",
    "\n",
    "print(\"Both systems failed:\")\n",
    "both_failed_cases = error_df[\n",
    "    (error_df[\"bm25_ndcg10\"] == 0) &\n",
    "    (error_df[\"best_hybrid_ndcg10\"] == 0)\n",
    "].head(10)\n",
    "\n",
    "display(both_failed_cases)\n",
    "\n",
    "# The error analysis shows that hybrid retrieval was most beneficial for vague queries where BM25 failed due to lexical mismatch.\n",
    "#  However, BM25 remained competitive for queries with strong keyword overlap, and both systems struggled with highly ambiguous ToT queries.\n",
    "# These findings suggest that lexical and semantic retrieval provide complementary strengths.\n"
   ]
