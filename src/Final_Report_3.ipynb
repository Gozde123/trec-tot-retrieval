   "source": [
    "# Win and loss analysis\n",
    "\n",
    "def get_per_query_ndcg_df(run_df, model_name):\n",
    "    rows = []\n",
    "\n",
    "    for m in ir_measures.iter_calc([nDCG@10], val_qrels_eval, run_df):\n",
    "        rows.append({\n",
    "            \"query_id\": str(m.query_id),\n",
    "            model_name: float(m.value)\n",
    "        })\n",
    "\n",
    "    return pd.DataFrame(rows)\n",
    "\n",
    "\n",
    "bm25_ndcg = get_per_query_ndcg_df(bm25_val_run_eval, \"BM25\")\n",
    "sbert_ndcg = get_per_query_ndcg_df(sbert_hybrid_best_run, \"Hybrid_SBERT\")\n",
    "bge_ndcg = get_per_query_ndcg_df(bge_hybrid_best_run, \"Hybrid_BGE_M3\")\n",
    "\n",
    "winloss_df = (\n",
    "    bm25_ndcg\n",
    "    .merge(sbert_ndcg, on=\"query_id\", how=\"outer\")\n",
    "    .merge(bge_ndcg, on=\"query_id\", how=\"outer\")\n",
    "    .fillna(0)\n",
    ")\n",
    "\n",
    "def win_loss_tie(row, model_a, model_b):\n",
    "    if row[model_a] > row[model_b]:\n",
    "        return f\"{model_a}_wins\"\n",
    "    elif row[model_a] < row[model_b]:\n",
    "        return f\"{model_b}_wins\"\n",
    "    else:\n",
    "        return \"tie\"\n",
    "\n",
    "winloss_df[\"SBERT_vs_BM25\"] = winloss_df.apply(\n",
    "    lambda row: win_loss_tie(row, \"Hybrid_SBERT\", \"BM25\"),\n",
    "    axis=1\n",
    ")\n",
    "\n",
    "winloss_df[\"BGE_vs_BM25\"] = winloss_df.apply(\n",
    "    lambda row: win_loss_tie(row, \"Hybrid_BGE_M3\", \"BM25\"),\n",
    "    axis=1\n",
    ")\n",
    "\n",
    "winloss_df[\"SBERT_vs_BGE\"] = winloss_df.apply(\n",
    "    lambda row: win_loss_tie(row, \"Hybrid_SBERT\", \"Hybrid_BGE_M3\"),\n",
    "    axis=1\n",
    ")\n",
    "\n",
    "summary_rows = []\n",
    "\n",
    "for col in [\"SBERT_vs_BM25\", \"BGE_vs_BM25\", \"SBERT_vs_BGE\"]:\n",
    "    counts = winloss_df[col].value_counts(normalize=True) * 100\n",
    "    raw_counts = winloss_df[col].value_counts()\n",
    "\n",
    "    for outcome in counts.index:\n",
    "        summary_rows.append({\n",
    "            \"Comparison\": col,\n",
    "            \"Outcome\": outcome,\n",
    "            \"Count\": raw_counts[outcome],\n",
    "            \"Percentage\": counts[outcome]\n",
    "        })\n",
    "\n",
    "winloss_summary_df = pd.DataFrame(summary_rows)\n",
    "\n",
    "display(winloss_summary_df)\n",
    "display(winloss_df.head())\n",
    "\n",
    "\n",
    "# According to the Win/Loss statistics, hybrid models outperformed the BM25 baseline for more search queries than they were worse.\n",
    "# Hybrid SBERT defeated BM25 in **13.3%** cases and was outperformed in **2.7%** cases, and Hybrid BGE-M3 achieved victory over the baseline in **15.3%**\n",
    "# cases and was defeated in **4.0%** cases."
   ]
