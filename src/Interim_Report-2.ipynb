      "source": [
        "cross_norm = cross_val_run_eval.groupby(\"query_id\").apply(minmax_normalize).reset_index(drop=True)\n",
        "bge_rr_hybrid_runs = []\n",
        "bge_rr_hybrid_run_dict = {}\n",
        "\n",
        "for l in np.linspace(0, 1, 11):\n",
        "    unique_id = f\"cross_rerun_{int(time.time())}_{l:.1f}\"\n",
        "\n",
        "    run = wandb.init(\n",
        "        project=\"trec-tot-hybrid-final\",\n",
        "        name=f\"BGE_RR_Lambda_{l:.1f}\",\n",
        "        id=unique_id,\n",
        "        reinit=True\n",
        "    )\n",
        "    merged = pd.merge(\n",
        "        bm25_norm,\n",
        "        cross_norm,\n",
        "        on=[\"query_id\", \"doc_id\"],\n",
        "        suffixes=(\"_bm25\", \"_cross\"),\n",
        "        how=\"outer\"\n",
        "    ).fillna(0)\n",
        "\n",
        "    merged[\"hybrid_score\"] = (1-l) * merged[\"norm_score_bm25\"] + l * merged[\"norm_score_cross\"]\n",
        "    eval_df = merged[[\"query_id\", \"doc_id\", \"hybrid_score\"]].rename(columns={\"hybrid_score\": \"score\"})\n",
        "\n",
        "\n",
        "    eval_df = eval_df.sort_values([\"query_id\", \"score\"], ascending=[True, False]).copy()\n",
        "    eval_df[\"rank\"] = eval_df.groupby(\"query_id\").cumcount() + 1\n",
        "\n",
        "    res = ir_measures.calc_aggregate(metrics, val_qrels_eval, eval_df)\n",
        "\n",
        "    log_data = {\n",
        "        \"lambda\": float(l),\n",
        "        \"nDCG@10\": res[nDCG@10],\n",
        "        \"cross_hybrid_nDCG@10\": res[nDCG@10],\n",
        "         \"cross_hybrid_nDCG@100\": res[nDCG@100],\n",
        "         \"cross_hybrid_nDCG@1000\": res[nDCG@1000],\n",
        "        \"cross_hybrid_RR@10\": res[RR@10],\n",
        "        \"cross_hybrid_Recall@10\": res[Recall@10],\n",
        "        \"cross_hybrid_Recall@100\": res[Recall@100],\n",
        "        \"cross_hybrid_Recall@500\": res[Recall@500]\n",
        "    }\n",
        "\n",
        "    wandb.log(log_data)\n",
        "    run.finish()\n",
        "\n",
        "\n",
        "    bge_rr_hybrid_runs.append(log_data)\n",
        "    bge_rr_hybrid_run_dict[float(l)] = eval_df.copy()\n",
        "\n",
        "\n",
        "bge_rr_wb_df = pd.DataFrame(bge_rr_hybrid_runs)\n",
        "display(bge_rr_wb_df.sort_values(\"nDCG@10\", ascending=False))\n",
        "\n",
        "\n",
        "best_idx = bge_rr_wb_df[\"nDCG@10\"].idxmax()\n",
        "bge_rr_best_l = float(bge_rr_wb_df.loc[best_idx, \"lambda\"])\n",
        "bge_rr_hybrid_best_run = bge_rr_hybrid_run_dict[bge_rr_best_l].copy()\n",
        "\n",
        "print(f\"\\nBGE-Reranker:\")\n",
        "print(f\"Base (1.0) nDCG@10: {bge_rr_base_score:.6f}\")\n",
        "print(f\"Best ({bge_rr_best_l}) nDCG@10: {bge_rr_best_score:.6f}\")"
      ]
    },
