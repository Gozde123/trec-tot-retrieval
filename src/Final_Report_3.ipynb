   "source": [
    "def explain_hybrid_scores(query_id, bm25_norm, dense_norm, final_run, top_n=10):\n",
    "    query_id = str(query_id)\n",
    "\n",
    "    query_text = val_queries_pt[\n",
    "        val_queries_pt[\"qid\"].astype(str) == query_id\n",
    "    ][\"query\"].iloc[0]\n",
    "\n",
    "    bm25_part = bm25_norm[[\"query_id\", \"doc_id\", \"norm_score\"]].rename(\n",
    "        columns={\"norm_score\": \"bm25_norm_score\"}\n",
    "    )\n",
    "\n",
    "    dense_part = dense_norm[[\"query_id\", \"doc_id\", \"norm_score\"]].rename(\n",
    "        columns={\"norm_score\": \"dense_norm_score\"}\n",
    "    )\n",
    "\n",
    "    final_part = final_run[[\"query_id\", \"doc_id\", \"score\", \"rank\"]].rename(\n",
    "        columns={\"score\": \"final_score\", \"rank\": \"final_rank\"}\n",
    "    )\n",
    "\n",
    "    merged = final_part.merge(\n",
    "        bm25_part,\n",
    "        on=[\"query_id\", \"doc_id\"],\n",
    "        how=\"left\"\n",
    "    ).merge(\n",
    "        dense_part,\n",
    "        on=[\"query_id\", \"doc_id\"],\n",
    "        how=\"left\"\n",
    "    )\n",
    "\n",
    "    merged = merged[merged[\"query_id\"].astype(str) == query_id].copy()\n",
    "\n",
    "    merged[\"bm25_norm_score\"] = merged[\"bm25_norm_score\"].fillna(0)\n",
    "    merged[\"dense_norm_score\"] = merged[\"dense_norm_score\"].fillna(0)\n",
    "\n",
    "    merged[\"doc_text\"] = merged[\"doc_id\"].map(doc_text_map)\n",
    "    merged[\"doc_preview\"] = merged[\"doc_text\"].astype(str).str.slice(0, 250)\n",
    "\n",
    "    print(\"QUERY ID:\", query_id)\n",
    "    print(\"QUERY:\", query_text)\n",
    "\n",
    "    display(\n",
    "        merged.sort_values(\"final_rank\")\n",
    "        [[\"final_rank\", \"doc_id\", \"bm25_norm_score\", \"dense_norm_score\", \"final_score\", \"doc_preview\"]]\n",
    "        .head(top_n)\n",
    "    )\n",
    "\n",
    "    return merged\n",
    "\n",
    "\n",
    "example_qid = str(improvement_cases.iloc[0][\"query_id\"])\n",
    "\n",
    "interpretability_table = explain_hybrid_scores(\n",
    "    query_id=example_qid,\n",
    "    bm25_norm=bm25_norm,\n",
    "    dense_norm=sbert_norm,\n",
    "    final_run=sbert_hybrid_best_run,\n",
    "    top_n=10\n",
